{
  "product": "SaveEvidence",
  "versionFile": "Directory.Build.props",
  "solutionFile": "SaveEvidence.slnx",
  "layout": {
    "roots": ["src"],
    "projectTitleStyle": "name",
    "solutionLabels": ["SaveEvidence.slnx"],
    "scriptRoots": ["buildScript", ".github"]
  },
  "gateWorkflow": "build.yml",
  "releaseBranches": [
    "main"
  ],
  "dryRunBranches": [
    "main",
    "dev"
  ],
  "settingsFiles": ["settings.json"],
  "requiredBuildProps": ["EnforceCodeStyleInBuild", "GenerateDocumentationFile", "CopyDocumentationFileToOutputDirectory", "PublishDocumentationFiles", "AnalysisLevel", "AnalysisMode", "TreatWarningsAsErrors"],
  "executableArchitecture": "anycpu",
  "artifactRetentionDays": 30,
  "releaseNotes": "4 種の UI 実装の配布物です。発行方式は Single AOT、Single（非 AOT）、EXE（フォルダー）の優先順で UI ごとに選ばれます（方式は配布物のフォルダー名に現れます。.github/RELEASE.md を参照）。",
  "uis": [
    {
      "name": "MewUI",
      "script": "buildScript/publish_MewUI.bat",
      "output": "publish/mewui-win-x64-aot",
      "exe": "SaveEvidence.MewUI.exe",
      "asset": "SaveEvidence.MewUI.v{version}.zip",
      "zip": true
    },
    {
      "name": "AvaloniaUI",
      "script": "buildScript/publish_AvaloniaUI.bat",
      "output": "publish/avaloniaui-win-x64-aot",
      "exe": "SaveEvidence.AvaloniaUI.exe",
      "asset": "SaveEvidence.AvaloniaUI.v{version}.zip",
      "zip": true
    },
    {
      "name": "WinForms",
      "script": "buildScript/publish_WinForms.bat",
      "output": "publish/winforms-win-x64-single",
      "exe": "SaveEvidence.WinForms.exe",
      "asset": "SaveEvidence.WinForms.v{version}.zip",
      "zip": true
    },
    {
      "name": "WinUI3",
      "script": "buildScript/publish_WinUI3.bat",
      "exe": "SaveEvidence.WinUI3.exe",
      "zip": true,
      "requiresWindowsAppRuntime": true,
      "outputs": [
        {
          "output": "publish/winui3-win-x64-aot",
          "asset": "SaveEvidence.WinUI3.v{version}.zip"
        },
        {
          "output": "publish/winui3-win-x64-single",
          "asset": "SaveEvidence.WinUI3.Single.v{version}.zip"
        }
      ]
    }
  ]
}
