{
  "product": "SaveEvidence",
  "versionFile": "Directory.Build.props",
  "solutionFile": "SaveEvidence.slnx",
  "gateWorkflow": "build.yml",
  "releaseBranches": [
    "main",
    "release/**"
  ],
  "artifactRetentionDays": 30,
  "releaseNotes": "2 種の UI 実装の配布物です。MewUI 版は Native AOT（マネージドコードは exe に同梱）、AvaloniaUI 版は Native AOT（exe + ネイティブ DLL）の zip です。",
  "uis": [
    {
      "name": "MewUI",
      "script": "buildScript/MewUI_publish_aot.bat",
      "output": "publish/mewui-win-x64-aot",
      "asset": "SaveEvidence.MewUI.zip",
      "zip": true
    },
    {
      "name": "AvaloniaUI",
      "script": "buildScript/AvaloniaUI_publish_aot.bat",
      "output": "publish/avaloniaui-win-x64-aot",
      "asset": "SaveEvidence.zip",
      "zip": true
    }
  ]
}
