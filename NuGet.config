<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 取得元は nuget.org だけにする（`<clear />` でマシン／ユーザー単位の取得元を打ち消す）。
       ユーザー単位の取得元（ローカルのフィード等）が混ざると、同じ `packages.lock.json` でも
       **別の版が解決される**（実測 2026-10-26: ローカルのフィードに古い EsUtil があり、
       0.1.0 を指定しているのに 0.1.2 が解決されて NU1605 になった）。

       未公開の EsUtil を試すときは、その環境でだけ取得元を足す（リポジトリの設定は変えない）。
       規則は .github/ビルド設定規約.md §4。 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
