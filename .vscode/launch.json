{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Avalonia: SaveEvidence",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/App.AvaloniaUI/src/App.AvaloniaUI.csproj",
            // モジュールの読み込み通知は動作に影響しないため出さない
            // （「モジュールが読み込まれました。シンボルが読み込まれました。」の行。 実測 2026-10-25）
            "logging": {
                "moduleLoad": false
            },
            // 最適化されたモジュールでもシンボルを読み込む
            // （「シンボルの読み込みをスキップしました」の通知自体を出さない。 デバッグの挙動は変わらない）
            "justMyCode": false
        },
        {
            "name": "MewUI: SaveEvidence",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/App.MewUI/src/App.MewUI.csproj",
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false
        },
        {
            // アンパッケージの WinUI 3 アプリは .NET ホスト（dotnet exec）から起動できない
            // （マニフェストによるアクティベーションと resources.pri の解決をアプリ ホストの exe が担うため、
            //   Microsoft.UI.Xaml.dll の stowed exception 0xC000027B で即座に終了する。 実測 2026-10-17）。
            // そのため exe を直接起動する。
            "name": "WinUI3: SaveEvidence",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "ビルド（App.WinUI3）",
            "program": "${workspaceFolder}/src/App.WinUI3/src/bin/Debug/net10.0-windows10.0.22621.0/win-x64/SaveEvidence.WinUI3.exe",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false,
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false
        },
        {
            "name": "WinForms: SaveEvidence",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/App.WinForms/src/App.WinForms.csproj",
            "logging": {
                "moduleLoad": false
            },
            "justMyCode": false
        }
    ]
}
