{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ビルド（全体・並列）",
      "detail": "ソリューション全体を MSBuild の並列ビルドでビルドする（端末では色付きの出力と工程ごとの所要時間が出る）",
      "type": "shell",
      "command": "dotnet build SaveEvidence.slnx",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（App.AvaloniaUI）",
      "type": "shell",
      "command": "dotnet build src/App.AvaloniaUI/src/App.AvaloniaUI.csproj",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（App.MewUI）",
      "type": "shell",
      "command": "dotnet build src/App.MewUI/src/App.MewUI.csproj",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（App.WinForms）",
      "type": "shell",
      "command": "dotnet build src/App.WinForms/src/App.WinForms.csproj",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "ビルド（App.WinUI3）",
      "type": "shell",
      "command": "dotnet build src/App.WinUI3/src/App.WinUI3.csproj",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "検証（全体）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "検証（全体・自動修正）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -Fix",
      "problemMatcher": []
    },
    {
      "label": "検証（ビルド省略）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -SkipBuild -SkipPackage",
      "problemMatcher": []
    },
    {
      "label": "検証（テスト省略）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verify.ps1 -SkipTests",
      "problemMatcher": []
    },
    {
      "label": "検証（文書とコードの走査のみ）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyDocs.ps1",
      "problemMatcher": []
    },
    {
      "label": "検証（配布物）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyPublish.ps1",
      "problemMatcher": []
    },
    {
      "label": "情報レベル（検出）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyInfoStyle.ps1",
      "problemMatcher": []
    },
    {
      "label": "情報レベル（修正）",
      "type": "shell",
      "command": "pwsh -NoProfile -File buildScript/verifyInfoStyle.ps1 -Fix",
      "problemMatcher": []
    },
    {
      "label": "テスト実行（全プロジェクト）",
      "type": "shell",
      "command": "dotnet test SaveEvidence.slnx",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "テスト実行（App.AvaloniaUI.Tests）",
      "type": "shell",
      "command": "dotnet test src/App.AvaloniaUI/tests/App.AvaloniaUI.Tests.csproj",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "テスト実行（フィルタ指定）",
      "type": "shell",
      "command": "dotnet test src/App.AvaloniaUI/tests/App.AvaloniaUI.Tests.csproj --filter ${input:testFilter}",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "テストフィルタ（例: FullyQualifiedName~AppPageTests）",
      "default": "FullyQualifiedName~AppPageTests"
    }
  ]
}
