<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EsUtil.SaveEvidence.LineDetection.Sample.ViewModels"
             x:Class="EsUtil.SaveEvidence.LineDetection.Sample.Views.VerifyAllPage"
             x:DataType="vm:VerifyAllPageViewModel">

    <DockPanel>

        <!-- ───────────── 左: サマリ + 検証結果一覧 ───────────── -->
        <Border DockPanel.Dock="Left" Width="360" Padding="12"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <TextBlock Text="dataset の全画像を検出し、正解データ（GroundTruth）と一括で照合します。"
                               FontSize="11" TextWrapping="Wrap"/>

                    <!-- サマリ -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="検証結果" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="#DDDDDD" CornerRadius="8" Padding="8,2">
                            <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="一致したデータ名は太字で表示されます。" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>

                    <Separator/>

                    <!-- 検証結果一覧 -->
                    <ItemsControl ItemsSource="{Binding VerifyResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:VerifyResultItem">
                                <Expander Margin="0,2" HorizontalAlignment="Stretch">
                                    <!-- 縮小時のヘッダー: 画像名、一致/不一致 -->
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="{Binding NameFontWeight}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <!-- 展開時の詳細: 4 辺 -->
                                    <ItemsControl ItemsSource="{Binding DetailLines}" Margin="12,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="#444444"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ───────────── 下部: ステータスバー ───────────── -->
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <!-- ───────────── 中央: プレースホルダー ───────────── -->
        <Border Background="#FF2B2B2B">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="全検証結果" FontSize="20" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="左の一覧で各画像の一致/不一致と差分を確認できます。"
                           FontSize="13" Foreground="#CCCCCC" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

    </DockPanel>

</UserControl>
