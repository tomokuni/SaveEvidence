<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.AvaloniaUI.Marquee</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574 で検出。公開メンバーの未記載は対象外）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="MarqueeControl.AvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 共有プラットフォーム抽象（カーソル操作: ICursorService / WinCursorService） -->
    <ProjectReference Include="..\..\Platform.AvaloniaUI\src\Platform.AvaloniaUI.csproj" />
    <!-- UI 非依存のコア（選択幾何・状態機械） -->
    <ProjectReference Include="..\..\MarqueeControl.Core\src\MarqueeControl.Core.csproj" />
    <!-- コントロール化のための転送規則（ホイール要求の解釈） -->
    <ProjectReference Include="..\..\MarqueeControl.CoreForControl\src\MarqueeControl.CoreForControl.csproj" />
    <!-- 描画の手順（層の順序と描画ポートへの写し）を単一所有する UI 非依存の描画層 -->
    <ProjectReference Include="..\..\MarqueeControl.Rendering\src\MarqueeControl.Rendering.csproj" />
  </ItemGroup>

</Project>
