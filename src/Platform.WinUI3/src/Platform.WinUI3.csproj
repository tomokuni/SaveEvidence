<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.SaveEvidence.Platform.WinUI3</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3（Microsoft.UI.Xaml）のコントロールと、WinRT の投影型（Windows.Foundation の幾何型・色型） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
    <!-- EsReadOnlyBitmap を Skia キャンバスへ描く表示ビュー（SkiaImageView）が SKXamlCanvas を使う -->
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="[3.*,4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\EsUtil\src\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- Skia への依存を閉じ込めた層（SKCanvas への描画と EsReadOnlyBitmap の Skia 相互変換） -->
    <ProjectReference Include="..\..\Platform.Skia\src\Platform.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Platform.WinUI3.Tests" />
  </ItemGroup>

</Project>
