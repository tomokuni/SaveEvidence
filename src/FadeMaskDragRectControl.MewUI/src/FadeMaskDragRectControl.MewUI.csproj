<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.FadeMaskDragRect.MewUI</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.FadeMaskDragRect.MewUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MewUI は API が安定化中（0.x）。破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内包コントロール（全て SkiaCanvasView を基底にする） -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <!-- 操作ログ（LoggerMessage ソース生成・NullLogger。内包するドラッグ選択コントロールへ伝搬する） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内包する MewUI コントロール（Marquee + Loupe） -->
    <ProjectReference Include="..\..\MarqueeControl.MewUI\src\MarqueeControl.MewUI.csproj" />
    <ProjectReference Include="..\..\LoupeControl.MewUI\src\LoupeControl.MewUI.csproj" />
    <!-- ホイール要求（ズーム / スクロール）の中継で型を直接参照する -->
    <ProjectReference Include="..\..\Feature.Marquee.Presenter\src\Feature.Marquee.Presenter.csproj" />
    <!-- 設定の分配（子コントロールの値の決定）と付加情報ラベルの描画を共有する -->
    <ProjectReference Include="..\..\CaptureSessionControl.UIBase\src\CaptureSessionControl.UIBase.csproj" />
    <!-- 表示位置の計算（LoupePositionCalculator）と表示情報の契約（LoupeLayout） -->
    <ProjectReference Include="..\..\Feature.Loupe.Core\src\Feature.Loupe.Core.csproj" />
    <!-- UI 非依存の動作モード・選択矩形オーバーレイ描画 -->
    <ProjectReference Include="..\..\CaptureSessionControl.Core\src\CaptureSessionControl.Core.csproj" />
    <!-- コア幾何型・座標変換ポート -->
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="FadeMaskDragRectControl.MewUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Skia\src\Platform.Skia.csproj" />
  </ItemGroup>

</Project>
