<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EsUtil.SaveEvidence.Parts.LineDetection.Sample.ViewModels"
        xmlns:views="clr-namespace:EsUtil.SaveEvidence.Parts.LineDetection.Sample.Views"
        x:Name="Root"
        x:Class="EsUtil.SaveEvidence.Parts.LineDetection.Sample.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ウィンドウ枠 辺検出サンプル"
        Width="1280" Height="820"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ───────────────────────── 左: ナビゲーションペイン ───────────────────────── -->
        <Border DockPanel.Dock="Left" Width="{Binding NavigationPanelWidth}"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Background="#F0F0F0">
            <Grid RowDefinitions="Auto,*">
                <!-- ナビゲーションヘッダー（クリックで開閉。折りたたみ時はアイコンのみ表示。アイコンは左端に固定） -->
                <Button Grid.Row="0"
                        Command="{Binding ToggleNavigationCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0"
                        Padding="6,8"
                        ToolTip.Tip="ナビゲーションの開閉">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8" HorizontalAlignment="Left">
                        <PathIcon Data="{Binding NavigationToggleIcon}" Width="16" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="辺検出サンプル" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="0,0,0,0"
                                   IsVisible="{Binding IsNavigationExpanded}"/>
                    </StackPanel>
                </Button>

                <!-- ナビゲーション本体（折りたたみ時はアイコンのみ表示） -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,0,10">
                    <StackPanel Spacing="12">

                        <!-- ナビゲーション -->
                        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPageItem}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Left"
                                                Margin="0,8"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{Binding Icon}" Width="16" Height="24" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"
                                                   IsVisible="{Binding #Root.DataContext.IsNavigationExpanded}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ───────────────────────── 中央: ページ切替 ───────────────────────── -->
        <Grid>

            <!-- 線分検出ページ -->
            <Grid IsVisible="{Binding IsLineDetectionPage}">
                <views:DetectPage DataContext="{Binding DetectPage}"/>
            </Grid>

            <!-- データ検証ページ -->
            <Grid IsVisible="{Binding IsVerifyLinesPage}">
                <views:VerifyPage DataContext="{Binding VerifyPage}"/>
            </Grid>

            <!-- データ作成ページ -->
            <Grid IsVisible="{Binding IsDatasetCreatePage}">
                <views:CreatePage DataContext="{Binding CreatePage}"/>
            </Grid>

            <!-- データ全検証ページ -->
            <Grid IsVisible="{Binding IsVerifyAllPage}">
                <views:VerifyAllPage DataContext="{Binding VerifyAllPage}"/>
            </Grid>

        </Grid>

    </DockPanel>

</Window>
