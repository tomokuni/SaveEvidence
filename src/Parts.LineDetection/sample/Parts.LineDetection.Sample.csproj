<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しない cref を CS1574、引数の対応違いを CS1572 / CS1573 で検出）。
         ライブラリと違い XML は配布物へ出さない（検証だけに使う）。
         記載のない公開メンバーの指摘（CS1591）は、アプリ・テスト・サンプルでは対象外にする。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EsUtil.SaveEvidence.Parts.LineDetection.Sample</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.*,)" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.*,)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.*,)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="[12.*,)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="[2.*,)" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <PackageReference Include="System.Reactive" Version="[7.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 検出ロジック（ロジック方式）を参照する -->
    <ProjectReference Include="..\src\Parts.LineDetection.csproj" />
    <!-- マウス位置の拡大表示（ルーペ）に使用する -->
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.ControlAvaloniaUI\src\AvaloniaUI\EsUtil.Feature.Loupe.ControlAvaloniaUI.csproj" />
    <!-- データセット作成ページの Marquee キャプチャ（スクリーン領域選択 + ウィンドウ列挙）に使用する -->
    <ProjectReference Include="..\..\Parts.CapturePreviewControl.AvaloniaUI\src\Parts.CapturePreviewControl.AvaloniaUI.csproj" />
    <!-- CaptureSessionControl.AvaloniaUI が内部で使用する要素検出（ウィンドウ列挙）機能 -->
    <ProjectReference Include="..\..\Platform.AvaloniaUI\src\Platform.AvaloniaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- dataset の検証用画像 + 正解 JSON を出力ディレクトリへコピーする（一致確認機能で使用） -->
    <Content Include="dataset\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
