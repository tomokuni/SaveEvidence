<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EsUtil.SaveEvidence.Parts.LineDetection.Sample</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- 開発者ツールは Debug だけに含める。 **PackageReference 自体は無条件**にする（プロジェクトの
         参照の有無を構成で変えると packages.lock.json が構成ごとに書き換わり、Release のビルド直後に
         Debug で復元すると NU1004 で失敗する。 実測 2026-10-26）。 -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <!-- 検出ロジック（ロジック方式）を参照する -->
    <ProjectReference Include="..\src\Parts.LineDetection.csproj" />
    <!-- マウス位置の拡大表示（ルーペ）に使用する -->
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.Loupe" />
    <!-- データセット作成ページの Marquee キャプチャ（スクリーン領域選択 + ウィンドウ列挙）に使用する -->
    <ProjectReference Include="..\..\Parts.CapturePreview.ControlAvaloniaUI\src\Parts.CapturePreview.ControlAvaloniaUI.csproj" />
    <!-- Parts.CapturePreview.ControlAvaloniaUI が内部で使用する要素検出（ウィンドウ列挙）機能 -->
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.Interop" />
  </ItemGroup>

  <ItemGroup>
    <!-- dataset の検証用画像 + 正解 JSON を出力ディレクトリへコピーする（一致確認機能で使用） -->
    <Content Include="dataset\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
