<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.CropView.AvaloniaUI</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.CropView.AvaloniaUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="CropViewControl.AvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 非依存の矩形オーバーレイ定義とラスタライザ -->
    <ProjectReference Include="..\..\CaptureSessionControl.Core\src\CaptureSessionControl.Core.csproj" />
    <!-- 領域選択オーバーレイ（Marquee + FadeMask + Loupe） -->
    <ProjectReference Include="..\..\FadeMaskDragRectControl.AvaloniaUI\src\FadeMaskDragRectControl.AvaloniaUI.csproj" />
    <!-- 画像ビューポート（拡大・パン・Fit） -->
    <ProjectReference Include="..\..\ZoomViewControl.AvaloniaUI\src\ZoomViewControl.AvaloniaUI.csproj" />
  </ItemGroup>

</Project>
