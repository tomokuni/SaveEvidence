<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.WinUI3</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 単一ファイル配布（publish_WinUI3.bat の自己完結 Single 版）では、参照側の WinUI 3 プロジェクトも
         resources.pri を埋め込む必要がある（PublishSingleFile は ProjectReference へ伝播する。 実測 2026-11-10:
         `PublishSingleFile requires EnableMsixTooling` で失敗）。 **RID を渡したときだけ有効にする**
         （RID の無い AnyCPU では MSIX のパッケージング処理が ProcessorArchitecture neutral で失敗する）。 -->
    <EnableMsixTooling Condition="'$(RuntimeIdentifier)' != ''">true</EnableMsixTooling>
    <!-- 単一ファイル（自己完結 Single 版）では PublishSingleFile が参照側へも伝播する。 クラス ライブラリは
         それ自体を配布しないため、Windows App SDK の構成検証（自己完結を要求する）だけを省く。
         `WindowsAppSDKSelfContained` は**クラス ライブラリには設定できない**（実測 2026-11-10:
         `WindowsAppSDKSelfContained should not be applied to a class library`）。 -->
    <WindowsAppSDKSingleFileVerifyConfiguration Condition="'$(PublishSingleFile)' == 'true'">false</WindowsAppSDKSingleFileVerifyConfiguration>
  </PropertyGroup>

  <ItemGroup>
    <!-- 単一ファイル配布では `AutoIncludeCopyToPublishDirectoryItems` が有効になり、プロジェクト直下の
         `packages.lock.json` も発行物へ入る。 参照側と合わせて同じ相対パスが 2 つになり
         NETSDK1152（同じ相対パスの発行出力ファイルが複数）で公開が失敗する（実測 2026-11-10）。 -->
    <None Remove="packages.lock.json" />
    <None Remove="packages.*.lock.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinUI 3 のコントロール（撮影スタックの表示は Composition と XAML の要素で行う） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則と提示の写像（切り出し矩形・設定・セッション状態・色の写像） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <!-- WinUI 3 版 Interop（コア型 ⇔ Win UI 型）と DIP 変換 -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Interop" />
    <!-- コア幾何型 -->
    <PackageReference Include="EsUtil.Platform.Core" />
    <!-- 複合コントロールを構成する内包コントロール -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Marquee" />
    <PackageReference Include="EsUtil.Ui.WinUI3.Loupe" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型（切り出しビューの描画・複合コントロールの内部手順）はテストからのみ参照する（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinUI3.Tests" />
  </ItemGroup>

</Project>
