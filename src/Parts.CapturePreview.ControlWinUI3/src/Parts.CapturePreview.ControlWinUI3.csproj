<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.WinUI3</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 のコントロール（撮影スタックの表示は Composition と XAML の要素で行う） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則と提示の写像（切り出し矩形・設定・セッション状態・色の写像） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <!-- WinUI 3 版 Interop（コア型 ⇔ Win UI 型）と DIP 変換 -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Interop" />
    <!-- コア幾何型 -->
    <PackageReference Include="EsUtil.Platform.Core" />
    <!-- 複合コントロールを構成する内包コントロール -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Marquee" />
    <PackageReference Include="EsUtil.Ui.WinUI3.Loupe" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型（切り出しビューの描画・複合コントロールの内部手順）はテストからのみ参照する（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinUI3.Tests" />
  </ItemGroup>

</Project>
