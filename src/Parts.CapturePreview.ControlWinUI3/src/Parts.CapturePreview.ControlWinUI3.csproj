<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.WinUI3</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3 のコントロール・描画（SKXamlCanvas。 撮影スタックの描画はすべて Skia のキャンバスへ行う） -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="[1.*,2.0.0)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.*,)" />
    <PackageReference Include="SkiaSharp.Views.WinUI" Version="[3.*,4.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則と提示の写像（切り出し矩形・設定・セッション状態・色の写像） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <!-- WinUI 3 版 Interop（コア型 ⇔ Win UI 型）と DIP 変換 -->
    <ProjectReference Include="..\..\Platform.WinUI3\src\Platform.WinUI3.csproj" />
    <!-- コア幾何型と Skia の描画プリミティブ -->
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform.Skia\src\Platform.Skia.csproj" />
    <!-- 複合コントロールを構成する内包コントロール -->
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil.Ui.WinUI3\Marquee\src\EsUtil.Ui.WinUI3.Marquee.csproj" />
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil.Ui.WinUI3\Loupe\src\EsUtil.Ui.WinUI3.Loupe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型（切り出しビューの描画・複合コントロールの内部手順）はテストからのみ参照する（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinUI3.Tests" />
  </ItemGroup>

</Project>
