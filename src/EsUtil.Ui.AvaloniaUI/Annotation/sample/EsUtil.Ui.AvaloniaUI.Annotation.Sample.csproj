<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.Ui.AvaloniaUI.Annotation.Sample</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- コアの画像（EsBitmap）を Avalonia の画像として表示するアダプタ -->
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.Interop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\EsUtil.Ui.AvaloniaUI.Annotation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="EsUtil.Feature.Annotation.Core" />
    <Using Include="EsUtil.Feature.Annotation.Presenter" />
  </ItemGroup>
</Project>
