<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CaptureSession</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.Parts.CaptureSession</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Platform.Core: コア幾何型・DPI 変換 -->
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
    <!-- 動作モードから FadeMaskRenderMode への変換、および設定の単一値（MarqueeOptions / LoupeOptions）の集約のため -->
    <ProjectReference Include="..\..\Feature.Marquee.Core\src\Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\Feature.Loupe.Core\src\Feature.Loupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ログ定義（LoggerMessage ソース生成）をコアが所有する（両 UI が同じ書式を共有する） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない。 指定はアセンブリ名） -->
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CaptureSession.AvaloniaUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CaptureSession.MewUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CaptureSession.UIBase" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.Core.Tests" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.MewUI.Tests" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.UIBase.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

</Project>
