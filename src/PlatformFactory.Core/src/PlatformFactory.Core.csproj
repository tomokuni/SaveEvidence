<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.Platform</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- EsBitmap がピクセルバッファへ直接アクセスするため unsafe を許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- EsBitmap は SkiaSharp のみに依存する（UI フレームワーク非依存のピクセルコンテナ） -->
    <PackageReference Include="SkiaSharp" Version="[3.119.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="PlatformFactory.Core.Tests" />
    <!-- CoordMath（internal）は PlatformFactory（Avalonia実装）の CoordTransform から利用する -->
    <InternalsVisibleTo Include="PlatformFactory" />
  </ItemGroup>

</Project>
