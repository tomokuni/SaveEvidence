<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.Platform.Skia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SKCanvas / SKBitmap への直接アクセス（ピクセルポインタ）のため unsafe を許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574 で検出）。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Skia への依存を本プロジェクトへ閉じ込める（UI 非依存層が SkiaSharp を参照しないための境界） -->
    <PackageReference Include="SkiaSharp" Version="[3.119.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 描画ポート（IEsCanvas）とラベル契約は Common、幾何値型とビットマップ（EsBitmap）は Platform.Core -->
    <ProjectReference Include="..\..\Common\src\Common.csproj" />
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="Platform.Skia.Tests" />
  </ItemGroup>

</Project>
