<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Platform.Skia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- SKCanvas / SKBitmap への直接アクセス（ピクセルポインタ）のため unsafe を許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Skia への依存を本プロジェクトへ閉じ込める（UI 非依存層が SkiaSharp を参照しないための境界） -->
    <PackageReference Include="SkiaSharp" Version="[3.119.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\EsUtil\src\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="Platform.Skia.Tests" />
  </ItemGroup>

</Project>
