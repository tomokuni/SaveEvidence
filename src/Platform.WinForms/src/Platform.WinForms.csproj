<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>EsUtil.SaveEvidence.Platform.WinForms</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- モニター単位の DPI 照会（Win32 の GetDpiForMonitor）は P/Invoke の座標構造体を伴うため有効化する
         （WinForms の公開 API にモニター単位の DPI 照会が無い。 規則は .github/ビルド設定規約.md §4）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="Platform.WinForms.Tests" />
  </ItemGroup>

</Project>
