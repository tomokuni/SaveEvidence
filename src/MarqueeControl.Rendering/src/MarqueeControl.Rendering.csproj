<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Marquee.Rendering</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574 で検出。公開メンバーの未記載は対象外）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- 描画側は「何を描くか」を知るためにコアを参照し、「どう描くか」を描画ポート（Platform.Core）へ委ねる。
         UI フレームワークは参照しない（UI はアダプタとして本層を参照する）。 -->
    <ProjectReference Include="..\..\Feature.MarqueeCore\src\Feature.MarqueeCore.csproj" />
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

</Project>
