<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.CaptureSession.AvaloniaUI</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.CaptureSession.AvaloniaUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
    <Page Remove="..\tests\**" />
    <AvaloniaXaml Remove="..\tests\**" />
    <EmbeddedResource Remove="..\tests\**" />
    <!-- sample/ は独立したサンプルアプリケーションのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\sample\**" />
    <None Remove="..\sample\**" />
    <Page Remove="..\sample\**" />
    <AvaloniaXaml Remove="..\sample\**" />
    <EmbeddedResource Remove="..\sample\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テストから internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="CaptureSessionControl.AvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CaptureSessionControl.Core\src\CaptureSessionControl.Core.csproj" />
    <!-- 設定 → 色の写像（両 UI で同じ写像を使う） -->
    <ProjectReference Include="..\..\CaptureSessionControl.UIBase\src\CaptureSessionControl.UIBase.csproj" />
    <ProjectReference Include="..\..\CropViewControl.AvaloniaUI\src\CropViewControl.AvaloniaUI.csproj" />
    <ProjectReference Include="..\..\Platform.AvaloniaUI\src\Platform.AvaloniaUI.csproj" />
  </ItemGroup>

</Project>

