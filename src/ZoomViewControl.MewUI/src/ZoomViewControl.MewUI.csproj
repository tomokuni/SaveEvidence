<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.MewUI.ZoomView</RootNamespace>
    <AssemblyName>ZoomViewControl.MewUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MewUI は API が安定化中（0.x）。破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- SkiaCanvasView（コアの EsBitmap をそのまま描画する） -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <!-- ズーム操作ログ（LoggerMessage ソース生成・NullLogger。Avalonia 版と同一の書式） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 非依存の純粋ロジック（Core）とコア幾何型を参照する -->
    <ProjectReference Include="..\..\ZoomViewControl.Core\src\ZoomViewControl.Core.csproj" />
    <ProjectReference Include="..\..\PlatformFactory.Core\src\PlatformFactory.Core.csproj" />
    <!-- MewUI の入力座標をコア型へ変換する（コア型 ⇔ MewUI 型） -->
    <ProjectReference Include="..\..\PlatformFactory.MewUI\src\PlatformFactory.MewUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="ZoomViewControl.MewUI.Tests" />
  </ItemGroup>

</Project>
