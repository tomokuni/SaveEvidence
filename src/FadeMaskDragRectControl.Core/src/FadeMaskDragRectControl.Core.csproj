<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.FadeMaskDragRect</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.FadeMaskDragRect</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
    <!-- 動作モードから FadeMaskRenderMode への変換、および設定の単一値（MarqueeOptions / MarqueeDecoOptions / FadeMaskAppearance / LoupeOptions）の集約のため -->
    <ProjectReference Include="..\..\Feature.Marquee.Core\src\Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\Feature.Loupe.Core\src\Feature.Loupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.FadeMaskDragRect.AvaloniaUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.FadeMaskDragRect.MewUI" />
    <!-- 設定とモードから子コントロールの値を解決する共有層（internal の Modes / State を参照する） -->
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.FadeMaskDragRect.UIBase" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.MewUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.Core.Tests" />
  </ItemGroup>

</Project>
