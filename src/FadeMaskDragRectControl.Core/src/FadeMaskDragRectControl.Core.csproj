<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.FadeMaskDragRect</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
    <!-- 動作モードから FadeMaskRenderMode への変換、および設定の単一値（MarqueeOptions / MarqueeDecoOptions / FadeMaskAppearance / LoupeOptions）の集約のため -->
    <ProjectReference Include="..\..\Feature.MarqueeCore\src\Feature.MarqueeCore.csproj" />
    <ProjectReference Include="..\..\Feature.LoupeCore\src\Feature.LoupeCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="FadeMaskDragRectControl.AvaloniaUI" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.MewUI" />
    <!-- 設定とモードから子コントロールの値を解決する共有層（internal の Modes / State を参照する） -->
    <InternalsVisibleTo Include="FadeMaskDragRectControl.UIBase" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.MewUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskDragRectControl.Core.Tests" />
  </ItemGroup>

</Project>
