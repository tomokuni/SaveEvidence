<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\EsUtil\src\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 提示層の外観型と、内包する選択矩形・ルーペのコア型（MarqueeOptions / LoupeOptions）。
         提示層は Core を参照し、その公開面にコアの型が現れるため、本層は提示層だけを宣言すれば両方を解決できる。 -->
    <ProjectReference Include="..\..\..\..\EsUtil\src\EsUtil.Feature.Marquee.Presenter\src\EsUtil.Feature.Marquee.Presenter.csproj" />
    <ProjectReference Include="..\..\..\..\EsUtil\src\EsUtil.Feature.Loupe.Presenter\src\EsUtil.Feature.Loupe.Presenter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定・入力の判断のログ定義（LoggerMessage ソース生成）を本プロジェクトが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部手順（切り出し矩形の解決・状態機械・幾何計算）は UI 実装とテストからのみ参照する -->
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlAvaloniaUI" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlMewUI" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinForms" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinUI3" />
    <InternalsVisibleTo Include="Parts.CapturePreview.Core.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlAvaloniaUI.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlMewUI.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinForms.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlWinUI3.Tests" />
  </ItemGroup>

</Project>
