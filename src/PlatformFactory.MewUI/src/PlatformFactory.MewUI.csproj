<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.MewUI.Platform</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI のコア（型・値型）。プラットフォームホストは含まない（本プロジェクトは UI 非依存の変換のみを担う） -->
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PlatformFactory.Core\src\PlatformFactory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="PlatformFactory.MewUI.Tests" />
  </ItemGroup>

</Project>
