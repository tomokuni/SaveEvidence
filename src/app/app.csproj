<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>app.Program</StartupObject>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA2101;SYSLIB1051;SYSLIB1054;MVVMTK0042;AVLN3001</NoWarn>
    <AssemblyName>SaveEvidence</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <PackageReference Include="Avalonia.Desktop" Version="[11.3.*,)" />
    <PackageReference Include="Avalonia.Diagnostics" Version="[11.3.*,)" />
    <PackageReference Include="FluentAvaloniaUI" Version="[2.3.*,)" />
    <!-- FluentIcons.Avalonia (必要に応じて追加) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.*,)" />
    <PackageReference Include="System.Drawing.Common" Version="[10.*,)" />
  </ItemGroup>

  <!-- _WinFormsBackup をビルド対象から除外 -->
  <ItemGroup>
    <Compile Remove="_WinFormsBackup\**" />
    <EmbeddedResource Remove="_WinFormsBackup\**" />
    <None Remove="_WinFormsBackup\**" />
  </ItemGroup>

</Project>
