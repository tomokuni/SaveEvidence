<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:app.ViewModels"
             xmlns:converters="clr-namespace:app.Converters"
             xmlns:local="clr-namespace:app.Views.Pages"
             x:Class="app.Views.Pages.FolderViewPage"
             x:DataType="vm:FolderViewViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:NegateConverter x:Key="NegateConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ツールバー -->
        <WrapPanel x:Name="ToolbarPanel" Grid.Row="0" Orientation="Horizontal" Margin="2">
            <Button Content="最新の情報に更新" Click="OnRefreshClick" Margin="1"/>
            <Separator Margin="2"/>
            <ToggleButton Content="特大" Click="OnViewModeClick" Tag="0" Margin="1"/>
            <ToggleButton Content="大" Click="OnViewModeClick" Tag="1" Margin="1"/>
            <ToggleButton Content="中" Click="OnViewModeClick" Tag="2" Margin="1"/>
            <Separator Margin="2"/>
            <ToggleButton Content="▲ 昇順" Click="OnSortAscendingClick" Tag="asc" Margin="1"/>
            <ToggleButton Content="▼ 降順" Click="OnSortDescendingClick" Tag="desc" Margin="1"/>
        </WrapPanel>

        <!-- 画像一覧表示 -->
        <ListBox x:Name="FileListBox"
                 Grid.Row="1"
                 SelectionMode="Single"
                 DoubleTapped="OnFileDoubleTapped">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:FileListItem">
                    <Border Margin="2" Padding="0">
                        <StackPanel Width="{Binding ThumbnailWidth}">
                            <Image Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   Width="{Binding ThumbnailWidth}"
                                   HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FileName}"
                                       Background="White"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Padding="1,1,2,1"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ステータスバー -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,2">
            <TextBlock Grid.Column="0" Text="{Binding ItemCountText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding ViewModeText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="{Binding SortStatusText}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="3" Text="{Binding FolderPathText}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
