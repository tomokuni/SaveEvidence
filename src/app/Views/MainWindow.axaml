<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:app.ViewModels"
        xmlns:pages="clr-namespace:app.Views.Pages"
        xmlns:conv="clr-namespace:app.Converters"
        x:Class="app.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SaveEvidence"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:IntToThicknessConverter x:Key="IntToThicknessConverter"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="MenuItem, Button, ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ナビゲーションパネルアイテムのスタイル -->
        <Style Selector="Border.NavItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.NavItem:hover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Border.NavItem.selected">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- メニューバー -->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..."
                          Command="{Binding OpenSaveFolderCommand}"/>
                <Separator/>
                <MenuItem Header="名前を付けて保存(_A)..."
                          Command="{Binding SaveImageCommand}"
                          IsEnabled="{Binding CanSave}"/>
                <MenuItem Header="クリップボードにコピー(_C)"
                          Command="{Binding CopyToClipboardCommand}"
                          IsEnabled="{Binding CanCopy}"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="OnExitMenuClick"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="画像を貼り付け(_P)"
                          IsEnabled="{Binding CanPaste}"
                          Click="OnPasteMenuClick"/>
                <MenuItem Header="元に戻す(_U)"
                          IsEnabled="{Binding HasPreviewImage}"
                          Click="OnUndoMenuClick"/>
            </MenuItem>
            <MenuItem Header="キャプチャ(_C)">
                <MenuItem Header="全画面キャプチャ(_S)"
                          Click="OnCaptureScreenClick"/>
                <MenuItem Header="ウィンドウ選択キャプチャ(_W)"
                          Click="OnCaptureWindowClick"/>
                <MenuItem Header="範囲選択キャプチャ(_A)"
                          Click="OnCaptureAreaClick"/>
            </MenuItem>
            <MenuItem Header="ツール(_T)">
                <MenuItem Header="切り出し(_R)"
                          IsEnabled="{Binding CanCopy}"
                          Click="OnCropMenuClick"/>
                <MenuItem Header="自動ウィンドウ切り出し(_W)"
                          IsEnabled="{Binding CanCopy}"
                          Command="{Binding AutoCropWindowCommand}"/>
                <Separator/>
                <MenuItem Header="フォルダを開く(_F)"
                          Command="{Binding OpenSaveFolderCommand}"/>
                <MenuItem Header="フォルダビュー(_V)..."
                          Click="OnFolderViewMenuClick"/>
            </MenuItem>
            <MenuItem Header="設定(_S)">
                <MenuItem Header="設定(_S)..."
                          Click="OnSettingsMenuClick"/>
            </MenuItem>
            <MenuItem Header="ヘルプ(_H)">
                <MenuItem Header="バージョン情報(_A)..."
                          Click="OnAboutMenuClick"/>
            </MenuItem>
        </Menu>

        <!-- メインコンテンツエリア（ナビゲーションパネル＋コンテンツ） -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- ナビゲーションパネル -->
            <Border Grid.Column="0"
                    Width="180"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- パネルヘッダー -->
                    <TextBlock Grid.Row="0"
                               Text="SaveEvidence"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="12,16,12,12"/>

                    <!-- ナビゲーションアイテム一覧 -->
                    <StackPanel Grid.Row="1">
                        <Border x:Name="NavCapture"
                                Classes="NavItem"
                                PointerPressed="OnNavCaptureClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🖼" FontSize="16"/>
                                <TextBlock Text="キャプチャ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavFolderView"
                                Classes="NavItem"
                                PointerPressed="OnNavFolderViewClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📁" FontSize="16"/>
                                <TextBlock Text="フォルダビュー" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="NavSettings"
                                Classes="NavItem"
                                PointerPressed="OnNavSettingsClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="⚙" FontSize="16"/>
                                <TextBlock Text="設定" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- パネルフッター（バージョン情報） -->
                    <TextBlock Grid.Row="2"
                               Text="v1.0.0"
                               FontSize="11"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               Margin="12,8"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- コンテンツエリア -->
            <Grid Grid.Column="1">
                <!-- ===== ページ0: キャプチャ（画像プレビュー） ===== -->
                <Grid x:Name="CaptureContent" RowDefinitions="Auto,*,Auto">
                    <!-- ツールバー -->
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0">
                        <Button ToolTip.Tip="保存" IsEnabled="{Binding CanSave}" Click="OnSaveButtonClick" Margin="1">
                            <TextBlock>💾 保存</TextBlock>
                        </Button>
                        <Button ToolTip.Tip="コピー" IsEnabled="{Binding CanCopy}" Click="OnCopyButtonClick" Margin="1">
                            <TextBlock>📋 コピー</TextBlock>
                        </Button>
                        <Separator Margin="2"/>
                        <Button ToolTip.Tip="貼り付け" Click="OnPasteButtonClick" Margin="1">
                            <TextBlock>📄 貼り付け</TextBlock>
                        </Button>
                        <Button ToolTip.Tip="元に戻す" IsEnabled="{Binding HasPreviewImage}" Click="OnUndoButtonClick" Margin="1">
                            <TextBlock>↩ 元に戻す</TextBlock>
                        </Button>
                        <Separator Margin="2"/>
                        <Button x:Name="CropButton" ToolTip.Tip="切り出し（切出し開始/確定）" IsEnabled="{Binding CanCopy}" Click="OnCropButtonClick" Margin="1">
                            <TextBlock x:Name="CropButtonText">✂ 切出し開始</TextBlock>
                        </Button>
                        <Button ToolTip.Tip="自動ウィンドウ切り出し" IsEnabled="{Binding CanCopy}" Command="{Binding AutoCropWindowCommand}" Margin="1">
                            <TextBlock>🪟 自動切出し</TextBlock>
                        </Button>
                        <Separator Margin="2"/>
                        <ToggleButton ToolTip.Tip="ルーペ表示切替" Click="OnLoupeToggleClick" Margin="1">
                            <TextBlock>🔍 ルーペ</TextBlock>
                        </ToggleButton>
                        <Separator Margin="2"/>
                        <Label Content="ズーム:" VerticalAlignment="Center"/>
                        <Button ToolTip.Tip="ズームイン" IsEnabled="{Binding CanZoomIn}" Click="OnZoomInButtonClick" Margin="1">
                            <TextBlock>＋</TextBlock>
                        </Button>
                        <Button ToolTip.Tip="ズームアウト" IsEnabled="{Binding CanZoomOut}" Click="OnZoomOutButtonClick" Margin="1">
                            <TextBlock>−</TextBlock>
                        </Button>
                        <ComboBox x:Name="ZoomComboBox"
                                  Width="100"
                                  ItemsSource="{Binding ZoomLabels}"
                                  SelectionChanged="OnZoomComboBoxSelectionChanged"/>
                    </WrapPanel>

                    <!-- メイン画像エリア -->
                    <Grid Grid.Row="1">
                        <!-- 画像表示領域（スクロール対応） -->
                        <ScrollViewer x:Name="ImageScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImageControl"
                                   Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </ScrollViewer>

                        <!-- 切り出しオーバーレイ（Canvas、ZIndexで画像の上に配置） -->
                        <Canvas x:Name="CropOverlay"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                ZIndex="50"/>

                        <!-- ルーペポップアップ -->
                        <Border x:Name="LoupeBorder"
                                IsVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderThickness="{Binding Settings.LoupeFrameWidth, Converter={StaticResource IntToThicknessConverter}}"
                                BorderBrush="{Binding Settings.LoupeFrameColor}"
                                Width="{Binding Settings.LoupeSize}"
                                Height="{Binding Settings.LoupeSize}"
                                ZIndex="100">
                            <Image x:Name="LoupeImage"
                                   Stretch="Fill"
                                   Width="{Binding Settings.LoupeSize}"
                                   Height="{Binding Settings.LoupeSize}"/>
                        </Border>
                    </Grid>

                    <!-- ステータスバー -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="4,2">
                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentFileNamePreview}" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>

                <!-- ===== ページ1: フォルダビュー ===== -->
                <pages:FolderViewPage x:Name="FolderViewContent" IsVisible="False"/>

                <!-- ===== ページ2: 設定 ===== -->
                <pages:SettingsPage x:Name="SettingsContent" IsVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
