<?xml version="1.0" encoding="utf-8"?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="false"
      throwConfigExceptions="false">

  <variable name="logDir" value="${specialfolder:folder=LocalApplicationData}/SaveEvidence/logs" />

  <targets>
    <target name="file" xsi:type="File"
            fileName="${logDir}/SaveEvidence.log"
            layout="${date:format=HH:mm:ss.fff} [${level:uppercase=true}] [${logger}] ${message}${onexception:inner=| ${exception:format=toString}}"
            concurrentWrites="true"
            keepFileOpen="true"
            encoding="utf-8"
            archiveEvery="Day"
            archiveNumbering="Date"
            archiveDateFormat="yyyyMMdd"
            maxArchiveDays="7" />
  </targets>

  <rules>
    <logger name="*" minLevel="Trace" writeTo="file" />
  </rules>
</nlog>