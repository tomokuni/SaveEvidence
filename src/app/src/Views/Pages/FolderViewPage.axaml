<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Estable.SaveEvidence.ViewModels"
             xmlns:controls="clr-namespace:Estable.SaveEvidence.Controls"
             xmlns:local="clr-namespace:Estable.SaveEvidence.Views.Pages"
             x:Class="Estable.SaveEvidence.Views.Pages.FolderViewPage"
             x:DataType="vm:FolderViewViewModel">
    <UserControl.Styles>
        <!-- ホバー中は枠をハイライトし、影を表示しない（擬似クラスによる状態変化はスタイルでのみ表現可能） -->
        <Style Selector="Border.thumbnail-frame:pointerover">
            <Setter Property="BorderBrush" Value="#0078D4"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ツールバー。上部の余白はウィンドウ最上部（タイトルバー領域）とのスペース。右側の余白はウィンドウ右上のシステムボタン（最小化・最大化・閉じる）との重なりを防止 -->
        <!-- 各 ToggleButton は x:Name で個別参照する（Tag ベースの一括走査は行わない） -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="2,6,140,2">
            <Button Classes="toolbar" Content="最新の情報に更新" Click="OnRefreshClick" Margin="1"/>
            <Separator Margin="2"/>
            <ToggleButton x:Name="ExtraLargeButton" Classes="toolbar" Content="特大" Click="OnViewModeClick" Tag="0" Margin="1"/>
            <ToggleButton x:Name="LargeButton" Classes="toolbar" Content="大" Click="OnViewModeClick" Tag="1" Margin="1"/>
            <ToggleButton x:Name="MediumButton" Classes="toolbar" Content="中" Click="OnViewModeClick" Tag="2" Margin="1"/>
            <Separator Margin="2"/>
            <ToggleButton x:Name="SortAscendingButton" Classes="toolbar" Content="▲ 昇順" Click="OnSortAscendingClick" Tag="asc" Margin="1"/>
            <ToggleButton x:Name="SortDescendingButton" Classes="toolbar" Content="▼ 降順" Click="OnSortDescendingClick" Tag="desc" Margin="1"/>
        </WrapPanel>

        <!-- 画像一覧表示（背景は Fluent テーマのデフォルト（SystemControlBackgroundChromeMediumLowBrush）に従う） -->
        <!--
        行の高さは固定値とせず各行の最大アイテム高さに応じる（BottomAlignWrapPanel）。
        アイテムは行内で下端揃えされ、ファイル名の 1 文字目の高さ位置が各行内で揃う。
        -->
        <ListBox x:Name="FileListBox"
                 Grid.Row="1"
                 SelectionMode="Single"
                 DoubleTapped="OnFileDoubleTapped">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:BottomAlignWrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:FileListItem">
                    <Border Margin="2" Padding="0">
                        <StackPanel Width="{Binding ThumbnailWidth}">
                            <!-- サムネイル画像（グレーの枠線 + ぼやかした影で浮かせる。ホバー時は枠ハイライト + 影なし） -->
                            <Border Classes="thumbnail-frame"
                                    BorderBrush="{DynamicResource SystemControlForegroundChromeGrayBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                    BoxShadow="{DynamicResource ThumbnailShadow}">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       Width="{Binding ThumbnailWidth}"
                                       HorizontalAlignment="Center"/>
                            </Border>
                            <!--
                            ファイル名領域の高さを固定する（2 行分）。
                            各行内で下端揃えされたアイテムのファイル名 1 文字目の高さ位置を揃えるため。
                            背景は透明（リスト背景が見える）・文字色はテーマに従う（ライト: 黒 / ダーク: 白）。
                            -->
                            <TextBlock Text="{Binding FileName}"
                                       TextAlignment="Center"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Height="30"
                                       Padding="1,1,2,1"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ステータスバー -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,2">
            <TextBlock Grid.Column="0" Text="{Binding ItemCountText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Text="{Binding ViewModeText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Text="{Binding SortStatusText}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="3" Text="{Binding FolderPathText}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
