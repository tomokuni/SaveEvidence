<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:app.Converters"
             x:Class="app.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 色変換用コンバーター -->
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <converters:StringIsNullOrEmptyConverter x:Key="StringIsNullOrEmptyConverter"/>
            <converters:BoundsToMarginConverter x:Key="BoundsToMarginConverter"/>
            <converters:NegateConverter x:Key="NegateConverter"/>

            <!-- フォルダビューのサムネイル影（Fluent テーマに BoxShadows の標準リソースがないため、
                 テーマ非依存の単一値として App レベルで定義する） -->
            <BoxShadows x:Key="ThumbnailShadow">0 3 10 0 #8A000000</BoxShadows>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- テキスト選択色の上書き（TextBox / ComboBox / NumericUpDown 等のテキスト選択時）。
             既定の Fluent テーマは濃い青（#FF0067C0）で黒文字が見にくいため、
             DropDown の選択項目と同程度の薄い青に変更し、前景は黒のまま維持する。
             リソースキー（TextSelectionBackgroundBrush）での上書きが Avalonia 12 で効かないため、
             コントロールのプロパティ（SelectionBrush / SelectionForegroundBrush）を直接スタイルで上書きする。 -->
        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="#FFB8D8FF"/>
            <Setter Property="SelectionForegroundBrush" Value="#FF000000"/>
        </Style>

        <!-- ツールバーボタン（各ページのツールバー高さを統一する。フォルダビューの標準ボタンサイズが基準） -->
        <Style Selector="Button.toolbar, ToggleButton.toolbar">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- ツールバーのテキストボックス（ファイル名テンプレート等）も同じ高さに揃える -->
        <Style Selector="TextBox.toolbar">
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- フルスクリーンボタン（最小化ボタンの左の斜め矢印）を無効化する（KIOSK 化機能は不要）。
             IsVisible=False にするとボタン群のスペースが消えて最小化・最大化・閉じるが左に寄るため、
             透明 + 非ヒットテストでスペースを維持したまま操作不可にする。 -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <!-- フルスクリーンモードのポップオーバーにも同ボタンが存在するため、同様に無効化する -->
        <Style Selector="Button#PART_PopoverFullScreenButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
    </Application.Styles>
</Application>
