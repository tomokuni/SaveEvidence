<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <StartupObject>app.Program</StartupObject>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);CA2101;SYSLIB1051;SYSLIB1054;MVVMTK0042;AVLN3001</NoWarn>
    <AssemblyName>SaveEvidence</AssemblyName>
    <UseWindowsForms>false</UseWindowsForms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- ヘッドレステスト（app.Tests）から internal メンバーへアクセスできるようにする -->
    <InternalsVisibleTo Include="app.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.*,)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.*,)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="[2.*,)" />
    <PackageReference Include="FluentAvaloniaUI" Version="[3.*,)" />
    <!-- FluentIcons.Avalonia (必要に応じて追加) -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[10.*,)" />
    <PackageReference Include="NLog" Version="[6.*,)" />
    <PackageReference Include="NLog.Extensions.Logging" Version="[6.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\SnipCaptureUI\src\SnipCaptureUI.csproj" />
    <ProjectReference Include="..\..\ColorPickerControl\src\ColorPickerControl.csproj" />
    <ProjectReference Include="..\..\PlatformFactory\src\PlatformFactory.csproj" />
    <ProjectReference Include="..\..\..\..\Estable\src\Estable\Estable.csproj" />
    <ProjectReference Include="..\..\..\..\Estable\src\Media\Media.csproj" />
    <ProjectReference Include="..\..\ZoomViewControl\src\ZoomViewControl.csproj" />
    <!-- ウィンドウ矩形の自動検出（切り出し）に使用する -->
    <ProjectReference Include="..\..\LineDetection\src\LineDetection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- アイコン（SVG）をアセンブリリソースとして埋め込む -->
    <AvaloniaResource Include="Icons/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- NLog 設定ファイル: 実行ディレクトリへ常に最新版をコピー（無いとログが一切出力されない） -->
    <None Update="nlog.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
    <Page Remove="..\tests\**" />
    <AvaloniaXaml Remove="..\tests\**" />
    <EmbeddedResource Remove="..\tests\**" />
  </ItemGroup>

</Project>

