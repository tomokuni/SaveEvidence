<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CaptureSession.MewUI</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.Parts.CaptureSession.MewUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MewUI は API が安定化中（0.x）。破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI のコントロール・描画（Windows 向け全バックエンド + SkiaCanvasView + GPU ブリッジ） -->
    <PackageReference Include="Aprillz.MewUI.Windows" Version="$(MewUIVersion)" />
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <PackageReference Include="Aprillz.MewUI.Skia.Interop.Direct2D" Version="$(MewUIVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則（切り出し矩形・設定・セッション状態・退避手順） -->
    <ProjectReference Include="..\..\App.Parts.CaptureSessionControl.Core\src\App.Parts.CaptureSessionControl.Core.csproj" />
    <!-- 設定 → 色の写像（両 UI で同じ写像を使う） -->
    <ProjectReference Include="..\..\App.Parts.CaptureSessionControl.UIBase\src\App.Parts.CaptureSessionControl.UIBase.csproj" />
    <!-- MewUI 版 Interop（コア型 ⇔ MewUI 型）と DIP 変換 -->
    <ProjectReference Include="..\..\App.Platform.MewUI\src\App.Platform.MewUI.csproj" />
    <!-- コア幾何型と Skia の描画プリミティブ -->
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
    <ProjectReference Include="..\..\App.Platform.Skia\src\App.Platform.Skia.csproj" />
    <!-- 画像ビューポート（拡大・パン・Fit。 切り出しの表示） -->
    <ProjectReference Include="..\..\App.Parts.ZoomViewControl.MewUI\src\App.Parts.ZoomViewControl.MewUI.csproj" />
    <!-- 複合コントロールを構成する内包コントロール -->
    <ProjectReference Include="..\..\MarqueeControl.MewUI\src\MarqueeControl.MewUI.csproj" />
    <ProjectReference Include="..\..\LoupeControl.MewUI\src\LoupeControl.MewUI.csproj" />
    <!-- ホイール要求（ズーム / スクロール）の中継と設定型の参照 -->
    <ProjectReference Include="..\..\Feature.Marquee.Presenter\src\Feature.Marquee.Presenter.csproj" />
    <ProjectReference Include="..\..\Feature.Loupe.Core\src\Feature.Loupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型（切り出しビューの描画・複合コントロールの内部手順）はテストからのみ参照する（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.MewUI.Tests" />
  </ItemGroup>

</Project>
