<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);MVVMTK0042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CaptureSessionControl.Core\src\CaptureSessionControl.Core.csproj" />
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
    <!-- 自動切り出しの矩形検出（LineDetection は UI 非依存） -->
    <ProjectReference Include="..\..\LineDetection\src\LineDetection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="SaveEvidence" />
    <InternalsVisibleTo Include="SaveEvidence.MewUI" />
    <InternalsVisibleTo Include="app.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="app.Core.Tests" />
    <InternalsVisibleTo Include="app.MewUI.Tests" />
  </ItemGroup>

</Project>
