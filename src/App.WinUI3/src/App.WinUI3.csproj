<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- publish のときだけ必要な指定（ビルドとテストには影響しない）。
         付けないと publish が自分自身の .pri（リソース インデックス）を発行せず、配布物の起動時に
         XAML の読み込みが失敗して 0xC000027B（stowed exception）で終了する（実測）。
         アンパッケージ（WindowsPackageType=None）のまま .pri を発行させるために必要である
         （配布は buildScript/publish_WinUI3.bat が行う）。
         **RID を渡したときだけ有効にする**: 有効にすると MSIX のパッケージング処理が走り、
         RID の無い AnyCPU では `Packaged .NET applications with an app host exe cannot be
         ProcessorArchitecture neutral.` でビルドが失敗する（実測 2026-10-30）。 -->
    <EnableMsixTooling Condition="'$(RuntimeIdentifier)' != ''">true</EnableMsixTooling>
    <!-- 単一ファイル化は行わない。 Native AOT はネイティブ DLL を exe へ内包できず、Windows App SDK も
         フレームワーク依存のまま PublishSingleFile を拒否する（実測 2026-10-20）。 WinUI 3 版は
         「AOT（フォルダー配布）」で公開する（buildScript/publish_WinUI3.bat）。 -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.SaveEvidence.App.WinUI3</RootNamespace>
    <!-- 実行ファイルの名前は製品名を優先する（配布物の exe 名。 命名規約の例外）。 -->
    <AssemblyName>SaveEvidence.WinUI3</AssemblyName>
    <!-- エントリ ポイントは本プロジェクトの Program.cs が持つ（XAML コンパイラの生成する Main を使わない）。
         DISABLE_XAML_GENERATED_MAIN は XAML コンパイラが生成する Program クラスを無効化する。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>EsUtil.SaveEvidence.App.WinUI3.Program</StartupObject>
    <!-- アンパッケージ（MSIX なし）で起動できるようにする。 -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- **Windows App Runtime へはフレームワーク依存で動く**（同封しない）。 自己完結（同封）は
         配布物が大きく、**起動が遅くメモリも多く使う**（コード ページを他のアプリと共有できず、
         フレームワークの保守も効かない。 Microsoft の展開ガイドの比較表。 サイズは
         .github/verify/verifyPublish.ps1 が実測して表示する）。 ランタイムが無い環境への導入は
         EsUtil.Ui.WinUI3.Interop の実装（Bootstrapping.WindowsAppRuntimeBootstrap）に任せる
         （Program.Main で呼ぶ。 下の WindowsAppSdkBootstrapInitialize も参照）。 -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- **Windows App SDK の自動初期化を止める**。 既定（true）ではモジュール読み込み時に Bootstrapper が走り、
         ランタイムが無い PC では SDK の案内 UI を出したうえで終了する（導入は行わない）。 本アプリは
         Program.Main で EsUtil.Ui.WinUI3.Interop の Bootstrapper に確認と導入を任せるため、自動初期化を
         止めて EsUtil だけが初期化する。 止めないと EsUtil の導入処理へ到達しない。 規則は
         .github/検証手順.md §17。 -->
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <!-- 配布物のアーキテクチャは publish の `-r`（win-x64）で渡す（csproj へ書くと復元とロックが RID ごとに分かれる）。
         AOT のネイティブ出力と Windows App Runtime の選択はその RID に従う。 -->
    <!-- DPI 認識（PerMonitorV2）を宣言する（宣言が無いとウィンドウ配置の復元がずれる）。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- **要求する Windows App Runtime の版をアプリのビルド版から取る**。 有効にすると
         `Microsoft.WindowsAppSDK.Runtime.Version`（internal）がこのプロジェクトへ生成され、
         WindowsAppRuntimeRequirement が読む。 有効にしないと EsUtil の焼き込んだ版
         （2.6.4）で初期化してしまい、アプリのマネージド アセンブリ（2.6.5）とネイティブ ランタイムが
         食い違って **本文のグリフだけが描かれない**（実測 2026-11-10）。 -->
    <WindowsAppSdkIncludeVersionInfo>true</WindowsAppSdkIncludeVersionInfo>
  </PropertyGroup>

  <!-- 自己完結のビルド（buildScript/publish_WinUI3.bat の Single 版が有効にする）。
       `-p:SaveEvidenceSelfContained=true` を渡すと Windows App Runtime と .NET を同梱する。
       用途は「ランタイムを導入できない環境（Windows Sandbox 等）で動かすこと」であり、**配布物**である
       （`SaveEvidence.WinUI3.Single.<版数>.zip` として Release へ添付する。 規則は .github/RELEASE.md）。
       コマンド ラインの `-p:WindowsAppSDKSelfContained=true` は参照プロジェクトへも伝播し、
       Windows App Runtime を持たないライブラリ側で失敗する（実測 2026-11-09）。そのため本プロジェクトの
       プロパティとして切り替える（`ProjectReference` へは伝播しない）。 -->
  <PropertyGroup Condition="'$(SaveEvidenceSelfContained)' == 'true'">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- 自己完結でビルドしたことをコードへ伝える（抑制属性も実行時判定も使わずに済む）。
         Program.Main はこの定数があるときだけ `MICROSOFT_WINDOWSAPPRUNTIME_BASE_DIRECTORY` を設定する
         （Windows App SDK の単一ファイル配布の要件。 実測 2026-11-10）。 -->
    <DefineConstants>$(DefineConstants);SE_WINDOWSAPPSDK_BUNDLED</DefineConstants>
  </PropertyGroup>

  <!-- publish（AOT）のときだけ有効にする指定。 buildScript/publish_WinUI3.bat が
       `-p:SaveEvidencePublishAot=true` を渡す（コマンド ラインの `-p:PublishAot=true` は参照プロジェクトへも
       伝播し、ライブラリの構成まで変わるため使わない）。 通常のビルドとテストには影響しない。 -->
  <PropertyGroup Condition="'$(SaveEvidencePublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <!-- 起動と定常の速度を優先する（既定のバランスよりコードを多く残す。 配布物は x64 の 1 形態のみ）。 -->
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <!-- メモリと配布物を減らす。 どれも本アプリが使わない機能である。
         - MetadataUpdaterSupport: ホット リロード用のメタデータ（製品では不要）
         - EventSourceSupport: EventSource のイベント（ログは Serilog が担う）
         - HttpActivityPropagationSupport: HttpClient の診断（通信は Windows App Runtime の導入時だけ） -->
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI 3（Microsoft.UI.Xaml）のコントロールと WinRT の投影型 -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <!-- Windows App SDK（コントロール・Composition・WIC） -->
    <!-- 起動時の合成ルート（サービスの生成と共有） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- 操作ログ（Avalonia 版 / MewUI 版と同一のファイルへ出力する） -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 非依存のコア（設定・ViewModel・画像コンテナ） -->
    <ProjectReference Include="..\..\App.Core\src\App.Core.csproj" />
    <!-- 撮影・切り出しの共通規則（切り出し矩形の計算・設定の写像） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <!-- WinUI 3 版の撮影セッション（オーバーレイ・切り出しビュー） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.ControlWinUI3\src\Parts.CapturePreview.ControlWinUI3.csproj" />
    <!-- WinUI 3 版 Interop（コア型 ⇔ WinUI 型・ウィンドウ配置の換算・表示の描画基盤） -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Interop" />
    <PackageReference Include="EsUtil.Ui.WinUI3.Thumbnail" />
    <!-- 設定画面の色選択（色名・16 進・ピッカーを 1 つにまとめたコントロール） -->
    <PackageReference Include="EsUtil.Ui.WinUI3.ColorSelector" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部型（サービス・ビュー）をテストから検証できるようにする -->
    <InternalsVisibleTo Include="App.WinUI3.Tests" />
  </ItemGroup>

  <!-- 配布物を「exe + ネイティブ DLL + 必須のリソース」へ絞る（実測 2026-10-20）。
       除外してよいことは、公開物から 1 種類ずつ削除して起動・終了・設定の往復を実測して確認した
       （.github/verify/verifyPublish.ps1 が毎回この構成を検査する）。
       残す必須のファイルは次の 3 つで、いずれも実測で削除すると起動または終了に失敗する。
       1. `<AssemblyName>.pri`: リソース インデックス（削除すると起動しない）
       2. `ja-JP` / `en-us` の `.mui`: WinUI の言語リソース（削除すると終了時に 0xC000027B で落ちる）
       3. `Microsoft.UI.Xaml\Assets` / `NpuDetect`: WinUI と Windows App SDK が参照する資産
       Windows App SDK を同梱する場合（自己完結）は WinUI ランタイムのネイティブ DLL が加わる。
       Native AOT はネイティブ DLL を exe へ内包できないため、これらは exe の隣へ置くしかない。 -->
  <Target Name="TrimWinUI3PublishNoise" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- WinRT のメタデータ（実行時は投影アセンブリが型情報を持つ） -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.winmd'" />
      <!-- アプリ以外のリソース インデックス（アプリの .pri が統合済み） -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)"
                       Condition="'%(Extension)' == '.pri' And '%(Filename)' != '$(AssemblyName)'" />
      <!-- 使わない言語の WinUI リソース（日本語と英語だけを残す）。
           言語フォルダーは配置先の相対パス（RelativePath）の先頭で判定する
           （RelativeDir は取得元のパスであり、配置先のフォルダーではない） -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)"
                       Condition="'%(Extension)' == '.mui'
                                  And !$([System.String]::Copy('%(RelativePath)').StartsWith('ja-JP'))
                                  And !$([System.String]::Copy('%(RelativePath)').StartsWith('en-us'))" />
      <!-- 実行時に参照しないファイル（コンパイル済み XAML、マニフェストの写し、Windows App SDK の定義） -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)"
                       Condition="('%(Filename)' == 'App' And '%(Extension)' == '.xaml')
                                  Or '%(Filename)%(Extension)' == 'app.manifest'
                                  Or '%(Filename)%(Extension)' == 'WindowsAppRuntime.png'
                                  Or $([System.String]::Copy('%(Filename)').StartsWith('workloads'))" />
      <!-- 本アプリが使わない Windows App SDK の部品（WebView2 とバックグラウンド タスクの仲介）。
           削除しても起動・終了・設定の往復が通ることを実測した（2026-10-20） -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)"
                       Condition="'%(Filename)%(Extension)' == 'Microsoft.Web.WebView2.Core.dll'
                                  Or '%(Filename)%(Extension)' == 'WebView2Loader.dll'
                                  Or '%(Filename)%(Extension)' == 'Microsoft.Windows.ApplicationModel.Background.UniversalBGTask.dll'" />
      <!-- 本アプリが使わない ML（ONNX Runtime・DirectML）と Windows AI のネイティブ実体。
           フレームワーク依存の publish はこれらをパッケージの資産としてそのまま出力する
           ソース参照 0 件であり、除いても起動・終了・設定の往復が通ることを .github/verify/verifyPublish.ps1 が確かめる。
           除かないと ML・Windows AI のネイティブ実体を配布物が無駄に運ぶ。 -->
      <_SEPublishNoise Include="@(ResolvedFileToPublish)"
                       Condition="'%(Filename)%(Extension)' == 'onnxruntime.dll'
                                  Or '%(Filename)%(Extension)' == 'onnxruntime_providers_shared.dll'
                                  Or '%(Filename)%(Extension)' == 'DirectML.dll'
                                  Or '%(Filename)%(Extension)' == 'Microsoft.Windows.AI.MachineLearning.dll'" />
      <ResolvedFileToPublish Remove="@(_SEPublishNoise)" />
    </ItemGroup>
  </Target>


</Project>
