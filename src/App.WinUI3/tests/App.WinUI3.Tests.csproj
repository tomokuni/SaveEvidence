<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinUI 3（UseWinUI）は OutputType を WinExe にするため、テスト ランナーが要求する
         実行可能ファイル（Exe）へ明示的に戻す（戻さないと xUnit v3 が起動できない）。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- テスト ホストは Windows App SDK を同封する（.NET 側はフレームワーク依存のまま）。
         同封しないと、Windows App Runtime が機械に無い環境（CI のランナー）で WinRT 型に触れたテストが
         ランタイム探索のダイアログを出して停止する（実測 2026-11-04。 6 件合格後にハング）。
         自己完結は RID を要求するためテストだけ固定する（アプリは publish の -r で渡す）。
         規則は .github/ビルド設定規約.md §4。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <RootNamespace>EsUtil.SaveEvidence.App.WinUI3.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\App.WinUI3.csproj" />
  </ItemGroup>

</Project>
