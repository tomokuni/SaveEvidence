<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.FadeMask</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="FadeMaskControl.AvaloniaUI" />
    <InternalsVisibleTo Include="FadeMaskControl.MewUI" />
    <InternalsVisibleTo Include="FadeMaskControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskControl.MewUI.Tests" />
    <InternalsVisibleTo Include="FadeMaskControl.Core.Tests" />
    <!-- アプリ本体（MewUI 版）もラベル文言の選定（FadeMaskLabels）を共用する -->
    <InternalsVisibleTo Include="SaveEvidence.MewUI" />
    <!-- MewUI 版の撮影セッションもラベル文言の選定（FadeMaskLabels）を共用する -->
    <InternalsVisibleTo Include="CaptureSessionControl.MewUI" />
  </ItemGroup>

</Project>
