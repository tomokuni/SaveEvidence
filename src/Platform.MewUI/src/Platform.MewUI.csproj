<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Platform.MewUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI のコア（型・値型）と Skia 描画（SkiaCanvasView・SKCanvas）。プラットフォームホストは含まない -->
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" />
    <!-- EsBitmap を Skia キャンバスへ描く表示ビュー（SkiaImageView）が SkiaCanvasView を使う -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="Platform.MewUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skia への依存を閉じ込めた層（SkiaEsCanvas / EsBitmap の Skia 相互変換） -->
    <ProjectReference Include="..\..\Platform.Skia\src\Platform.Skia.csproj" />
  </ItemGroup>

</Project>
