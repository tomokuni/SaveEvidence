<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.SaveEvidence.App.AvaloniaUI</RootNamespace>
    <!-- 実行ファイルの名前は製品名を優先する（配布物の exe 名。 命名規約の例外）。 -->
    <AssemblyName>SaveEvidence.AvaloniaUI</AssemblyName>
    <StartupObject>EsUtil.SaveEvidence.App.AvaloniaUI.Program</StartupObject>
    <!-- 抑止は .github/ビルド設定規約.md の「付録 A 抑止の一覧」に理由付きで載せたものだけとする。
         AVLN3001: アプリはコンパイル済み XAML を使い、ランタイム ローダーを使わない。
         公開のパラメーターなしコンストラクターを足すと DI の設計が壊れる。 -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <UseWindowsForms>false</UseWindowsForms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
    <!-- publish 専用の指定（PublishSingleFile / SelfContained / RuntimeIdentifier / PublishReadyToRun）は
         ここへ書かない。 構成（Release）へ書くと `dotnet build -c Release` が自己完結として扱われ、
         本プロジェクトを参照するテスト プロジェクトが NETSDK1151（自己完結の exe は参照できない）で
         ビルドできなくなる（復元は既定の Debug 構成で走るため NETSDK1047 も出る）。
         publish は buildScript/publish_AvaloniaUI.bat が -r <RID> -p:PublishAot=true -p:SelfContained=true を
         明示して実行する。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ヘッドレステスト（App.AvaloniaUI.Tests）から internal メンバーへアクセスできるようにする -->
    <InternalsVisibleTo Include="App.AvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\App.Core\src\App.Core.csproj" />
    <ProjectReference Include="..\..\Parts.CapturePreview.ControlAvaloniaUI\src\Parts.CapturePreview.ControlAvaloniaUI.csproj" />
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.Interop" />
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.ColorComboBox" />
    <PackageReference Include="EsUtil.Ui.AvaloniaUI.Thumbnail" />
  </ItemGroup>

  <ItemGroup>
    <!-- アイコン（SVG）をアセンブリリソースとして埋め込む -->
  </ItemGroup>

</Project>

