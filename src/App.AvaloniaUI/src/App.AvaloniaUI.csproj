<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.SaveEvidence.App.AvaloniaUI</RootNamespace>
    <StartupObject>EsUtil.SaveEvidence.App.AvaloniaUI.Program</StartupObject>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- AVLN3001 はアプリの設計上解消できないため理由付きで抑止する（唯一の抑止）。
         MainWindow は DI コンストラクターだけを持ち、XAML はコンパイル済みとして読み込む（ランタイム ローダーを使わない）。
         公開のパラメーターなしコンストラクターを足すと DI の設計が壊れる。 -->
    <NoWarn>$(NoWarn);CA2101;SYSLIB1051;SYSLIB1054;MVVMTK0042;AVLN3001</NoWarn>
    <UseWindowsForms>false</UseWindowsForms>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
    <!-- publish 専用の指定（PublishSingleFile / SelfContained / RuntimeIdentifier / PublishReadyToRun）は
         ここへ書かない。 構成（Release）へ書くと `dotnet build -c Release` が自己完結として扱われ、
         本プロジェクトを参照するテスト プロジェクトが NETSDK1151（自己完結の exe は参照できない）で
         ビルドできなくなる（復元は既定の Debug 構成で走るため NETSDK1047 も出る）。
         publish は buildScript/*_publish_aot.bat が -r <RID> -p:PublishAot=true -p:SelfContained=true を
         明示して実行する。 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ヘッドレステスト（app.AvaloniaUI.Tests）から internal メンバーへアクセスできるようにする -->
    <InternalsVisibleTo Include="App.AvaloniaUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.*,)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.*,)" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="[2.*,)" />
    <PackageReference Include="FluentAvaloniaUI" Version="[3.*,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[10.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[10.*,)" />
    <PackageReference Include="Serilog" Version="[4.*,)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="[10.*,)" />
    <PackageReference Include="Serilog.Sinks.File" Version="[7.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\App.Core\src\App.Core.csproj" />
    <ProjectReference Include="..\..\Parts.CapturePreviewControl.AvaloniaUI\src\Parts.CapturePreviewControl.AvaloniaUI.csproj" />
    <ProjectReference Include="..\..\ColorPickerControl.AvaloniaUI\src\ColorPickerControl.AvaloniaUI.csproj" />
    <ProjectReference Include="..\..\Platform.AvaloniaUI\src\Platform.AvaloniaUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- アイコン（SVG）をアセンブリリソースとして埋め込む -->
    <AvaloniaResource Include="Icons/**" />
  </ItemGroup>

</Project>

