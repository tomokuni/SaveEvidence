<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EsUtil.SaveEvidence.App.Core.ViewModels;assembly=App.Core"
        xmlns:pages="clr-namespace:EsUtil.SaveEvidence.App.AvaloniaUI.Views.Pages"
        xmlns:services="clr-namespace:EsUtil.SaveEvidence.App.Core.Services;assembly=App.Core"
        x:Class="EsUtil.SaveEvidence.App.AvaloniaUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{x:Static services:AppIdentity.ProductName}"
        Width="640" Height="400"
        MinWidth="640" MinHeight="400"
        Background="{DynamicResource PageBackgroundBrush}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="32">
    <Window.Styles>
        <!-- タイトル文字は描かない（WindowDecorations=BorderOnly。 Window.Title はタスクバーの表示に使う） -->
        <Style Selector="MenuItem, Button, ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ウィンドウ操作ボタン（自前）。 他の UI 版と同じ 46 × 32 DIP で、角を付けない -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ナビゲーションパネルアイテムのスタイル。
             選択中は WinUI 3 と同じ「薄いグレーの角丸背景 + 左端の青いマーク」で示す -->
        <Style Selector="Border.NavItem">
            <Setter Property="Padding" Value="4,8"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.NavItem:hover">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
        </Style>
        <Style Selector="Border.NavItem.selected">
            <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
        </Style>
        <Style Selector="Border.NavItem.selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource NavItemSelectedBrush}"/>
        </Style>
        <!-- 左端のマーク（既定は透明。 選択中だけアクセント色にする） -->
        <Style Selector="Border.NavSelectionMark">
            <Setter Property="Width" Value="3"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="1.5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.NavItem.selected Border.NavSelectionMark">
            <Setter Property="Background" Value="{DynamicResource NavSelectionAccentBrush}"/>
        </Style>

        <!-- ナビゲーション開閉ボタンのスタイル（パネル背景に馴染ませる。 アイコンのみ） -->
        <Style Selector="Button.NavToggle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.NavToggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="Button.NavToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListLowBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <Style Selector="Button.NavToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListMediumBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
        </Style>
        <!-- フルスクリーンボタン（最小化ボタンの左の斜め矢印）を無効化する（KIOSK 化機能は不要）。
             IsVisible=False にするとボタン群のスペースが消えて最小化・最大化・閉じるが左に寄るため、
             透明 + 非ヒットテストでスペースを維持したまま操作不可にする。 -->
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <!-- フルスクリーンモードのポップオーバーにも同ボタンが存在するため、同様に無効化する -->
        <Style Selector="Button#PART_PopoverFullScreenButton">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
    </Window.Styles>

    <!-- Background を Transparent にするのは、余白（ページの背景）の押下を本 Grid で受け取るため
         （null のままだとヒットテストの対象外になり、タイトル バー相当の帯でドラッグできない） -->
    <Grid ColumnDefinitions="Auto,*" Background="Transparent" PointerPressed="OnWindowPointerPressed">
        <!-- ページ領域の左の余白（ナビゲーション パネルの収納時の幅）。
             ナビを開いてもページ領域は動かさない（開いたナビはページ領域の上へ重ねる） -->
        <Border Grid.Column="0" Width="{x:Static services:NavPanelMetrics.CompactWidth}"/>

        <!-- メインコンテンツエリア（ページ領域。 ナビの開閉で移動しない） -->
        <Grid Grid.Column="1">
            <!-- ===== ページ0: キャプチャ（画像プレビュー） ===== -->
            <pages:CapturePage x:Name="CaptureContent"/>

            <!-- ===== ページ1: フォルダビュー ===== -->
            <pages:FolderViewPage x:Name="FolderViewContent" IsVisible="False"/>

            <!-- ===== ページ2: Undo 一覧 ===== -->
            <pages:UndoPage x:Name="UndoContent" IsVisible="False"/>

            <!-- ===== ページ3: 設定 ===== -->
            <pages:SettingsPage x:Name="SettingsContent" IsVisible="False"/>
        </Grid>

        <!-- ナビパネルの背景（ページ領域の上へ重ねる。 上端はタイトル バーの下、下端はステータス バーに被る）。
             NavPanel は収納時に Top + Auto 高さへ縮むため、その下の白見えを防ぐために本 Border が下端まで塗る -->
        <Border Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                Width="{Binding NavPanelWidth}"
                Background="{DynamicResource NavPanelBackgroundBrush}"/>

        <!-- ナビゲーションパネル（左・開閉可能）。 一番上に開閉ボタン（アイコンのみ）を置く。
             背景は上の全高 Border が担うため Transparent -->
        <Border x:Name="NavPanel"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                Width="{Binding NavPanelWidth}"
                Background="Transparent">
            <!--
            RowDefinitions の * 行は展開時のフッター（v1.0.0）をウィンドウ下端へ押し下げる（Auto ではアイテム直後に来てしまう）。
            収納時は NavPanel がコンテンツ高さに縮むため * 行は 0 になり、下部の余白は UpdateNavPanelLayout の
            Padding（背景色付き）で確保する（設定アイコンの下が白く見えないようにする）。
            -->
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 44 = ツールバーの行（6 + 32）と同じ中心になる高さ（WindowLayout.AppIconRowHeight） -->
                    <RowDefinition Height="44"/>
                    <!-- 40 = ナビの開閉ボタンの高さ（WindowLayout.NavToggleHeight） -->
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 左上のアプリ アイコン（タスク バーと同じアイコン）。 押下で Windows の標準メニューを出す -->
                <Button x:Name="AppIconButton"
                        Grid.Row="0"
                        Width="{x:Static services:WindowLayout.AppIconColumnWidth}"
                        Height="{x:Static services:WindowLayout.AppIconRowHeight}"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="0"
                        Click="OnAppIconClick"
                        ToolTip.Tip="ウィンドウ メニュー">
                    <PathIcon x:Name="AppIconImage"
                              Width="{x:Static services:WindowLayout.AppIconSize}"
                              Height="{x:Static services:WindowLayout.AppIconSize}"
                              Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                </Button>

                <!-- ナビゲーションの開閉（アイコンのみ。 開いているときは「閉じる」、閉じているときは「開く」）と、
                     その右のアプリ名（展開時のみ表示） -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavToggleButton"
                            Classes="NavToggle"
                            Width="40"
                            Height="40"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="4"
                            VerticalAlignment="Center"
                            Click="OnNavToggleClick"
                            ToolTip.Tip="ナビゲーションを開閉">
                        <PathIcon x:Name="NavToggleIcon" Width="16" Height="16"/>
                    </Button>
                    <TextBlock x:Name="NavTitleText"
                               Text="SaveEvidence"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsNavigationExpanded}"/>
                </StackPanel>
                <!-- ナビゲーションアイテム一覧（収納時はアイコンのみ。アイコンの位置は展開時と同じ左端に固定）。
                     下部余白 8px により、収納時も設定アイコンの下が背景色で塗られる -->
                <StackPanel Grid.Row="2" Margin="0,8,0,8">
                    <Border x:Name="NavCapture"
                            Classes="NavItem"
                            ToolTip.Tip="キャプチャ"
                            PointerPressed="OnNavCaptureClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="NavSelectionMark" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <PathIcon x:Name="NavCaptureIcon" Width="16" Height="16"/>
                                <TextBlock Text="キャプチャ"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="NavFolderView"
                            Classes="NavItem"
                            ToolTip.Tip="フォルダビュー"
                            PointerPressed="OnNavFolderViewClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="NavSelectionMark" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <PathIcon x:Name="NavFolderViewIcon" Width="16" Height="16"/>
                                <TextBlock Text="フォルダビュー"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="NavUndo"
                            Classes="NavItem"
                            ToolTip.Tip="Undo 一覧"
                            PointerPressed="OnNavUndoClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="NavSelectionMark" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <PathIcon x:Name="NavUndoIcon" Width="16" Height="16"/>
                                <TextBlock Text="Undo 一覧"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border x:Name="NavSettings"
                            Classes="NavItem"
                            ToolTip.Tip="設定"
                            PointerPressed="OnNavSettingsClick">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Classes="NavSelectionMark" Grid.Column="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <PathIcon x:Name="NavSettingsIcon" Width="16" Height="16"/>
                                <TextBlock Text="設定"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding IsNavigationExpanded}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- パネルフッター（UI 名とバージョン。 収納時は非表示）。 背景は全高の Border が担う。
                     バージョンは AppVersion（App.Core）から取り、コード ビハインドで設定する -->
                <TextBlock x:Name="VersionText"
                           Grid.Row="3"
                           FontSize="11"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                           Margin="12,8"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsNavigationExpanded}"/>
            </Grid>
        </Border>

        <!-- ウィンドウ操作ボタン（自前）。 WindowDecorations="BorderOnly" のため標準のボタンは描かれない。
             他の UI 版と同じ 46 × 32 DIP・右上配置にする。 -->
        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Button Classes="caption" Click="OnMinimizeClick" ToolTip.Tip="最小化">
                <TextBlock Text="&#xE921;"/>
            </Button>
            <Button x:Name="MaximizeButton" Classes="caption" Click="OnMaximizeClick" ToolTip.Tip="最大化">
                <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"/>
            </Button>
            <Button Classes="caption close" Click="OnCloseClick" ToolTip.Tip="閉じる">
                <TextBlock Text="&#xE8BB;"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>