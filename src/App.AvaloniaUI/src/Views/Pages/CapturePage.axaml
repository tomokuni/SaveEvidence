<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EsUtil.SaveEvidence.App.Core.ViewModels;assembly=App.Core"
             xmlns:crop="clr-namespace:EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI.Crop;assembly=Parts.CapturePreview.ControlAvaloniaUI"
             x:Class="EsUtil.SaveEvidence.App.AvaloniaUI.Views.Pages.CapturePage"
             x:DataType="vm:MainViewModel">
    <UserControl.Resources>
        <!-- スライダのツマミ（サム）サイズを小さくする（Fluent テーマの既定 20px → 10px） -->
        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
        <!-- スライダ全体の高さ（Fluent テーマの既定 32px → 24px）。テンプレートの MinHeight に使われる -->
        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
        <!-- トラック前後の余白（Fluent テーマの既定 15px → 10px）。サム 10px に合わせて縮小し、
             固定余白 + トラック行の合計が 24px に収まるようにする -->
        <GridLength x:Key="SliderPreContentMargin">10</GridLength>
        <GridLength x:Key="SliderPostContentMargin">10</GridLength>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- トラックのヒット領域を広げる FocusTarget の上下拡大マージン（-10px）を 0 に上書きし、
             トラック行の高さ要求を 4px に抑える（これがないと 24px の高さに収まらず上半分が切れる） -->
        <Style Selector="Slider /template/ Border#FocusTarget">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <!-- ファイル名テンプレートのバリデーションエラー時に枠線を赤くする（フォーカス・ホバー状態でもテーマスタイルに優先する） -->
        <Style Selector="TextBox.validation-error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ツールバー（左端にハンバーガーメニュー）。上部の余白はウィンドウ最上部（タイトルバー領域）とのスペース。右側の余白はシステムボタン（最小化・最大化・閉じる）との重なりを防止 -->
        <WrapPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" Margin="2,6,140,2">
            <Button x:Name="HamburgerButton"
                    Classes="toolbar"
                    ToolTip.Tip="メニュー"
                    Margin="1"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem x:Name="SaveMenuItem"
                                  Header="File - 画像を保存"
                                  Command="{Binding SaveImageCommand}"
                                  IsEnabled="{Binding CanSave}"
                                  InputGesture="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Clipboard - コピー"
                                  Command="{Binding CopyToClipboardCommand}"
                                  IsEnabled="{Binding CanCopy}"
                                  InputGesture="Ctrl+C"/>
                        <MenuItem Header="Clipboard - 貼り付け"
                                  IsEnabled="{Binding CanPaste}"
                                  Click="OnPasteMenuClick"
                                  InputGesture="Ctrl+V"/>
                        <Separator/>
                        <MenuItem Header="Image - 元に戻す"
                                  IsEnabled="{Binding HasPreviewImage}"
                                  Click="OnUndoMenuClick"
                                  InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Image - 元に戻すを取り消す"
                                  IsEnabled="{Binding HasPreviewImage}"
                                  Click="OnRedoMenuClick"
                                  InputGesture="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem x:Name="CaptureScreenMenuItem"
                                  Header="Capture - スクリーン選択"
                                  Click="OnCaptureScreenClick"/>
                        <MenuItem x:Name="CaptureWindowMenuItem"
                                  Header="Capture - ウィンドウ選択"
                                  Click="OnCaptureWindowClick"/>
                        <MenuItem x:Name="CaptureAreaMenuItem"
                                  Header="Capture - 範囲選択"
                                  Click="OnCaptureAreaClick"/>
                        <Separator/>
                        <MenuItem x:Name="CropMenuItem"
                                  Header="Crop - 切り出し"
                                  IsEnabled="{Binding CanCopy}"
                                  Click="OnCropMenuClick"
                                  InputGesture="Ctrl+R"/>
                        <MenuItem Header="Crop - 自動切り出し"
                                  IsEnabled="{Binding CanCopy}"
                                  Command="{Binding AutoCropWindowCommand}"/>
                    </MenuFlyout>
                </Button.Flyout>
                <TextBlock Text="☰" FontSize="16" VerticalAlignment="Center"/>
            </Button>
            <Border Classes="toolbar-separator"/>
            <!-- 保存するファイル名テンプレート（保存ボタンの左） -->
            <!-- テキストの内容に応じて幅を自動調整する（TextChanged で FormattedText 計測。MinWidth（100）の範囲内、上限は
                 ツールバーが折り返さない幅 = ツールバー幅から他の要素を除いた幅） -->
            <!-- ToolTip は {date}/{time} がマークアップ拡張と衝突するため、コードビハインド（Initialize）で設定する -->
            <TextBox x:Name="FileNameTemplateBox"
                     Classes="toolbar"
                     Text="{Binding FileNameTemplateText}"
                     Classes.validation-error="{Binding HasInvalidTemplate}"
                     MinWidth="100"
                     VerticalContentAlignment="Center"
                     Margin="1"
                     TextChanged="OnFileNameTemplateTextChanged"/>
            <!-- 保存ボタン（フライアウトメニューのキャプチャボタンの左） -->
            <!-- ToolTip は保存先フォルダを含むため、コードビハインド（Initialize / フォルダ変更時）で設定する -->
            <Button x:Name="SaveButton"
                    Classes="toolbar toolbar-icon"
                    Command="{Binding SaveImageCommand}"
                    IsEnabled="{Binding CanSave}"
                    Margin="1"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <PathIcon x:Name="SaveIcon" Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}"/>
                </StackPanel>
            </Button>
            <Border Classes="toolbar-separator"/>
            <Button ToolTip.Tip="スクリーン選択キャプチャ" Classes="toolbar toolbar-icon" Click="OnCaptureScreenClick" Margin="1" VerticalAlignment="Center">
                <PathIcon x:Name="ScreenSelectIcon" Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}"/>
            </Button>
            <Button ToolTip.Tip="ウィンドウ選択キャプチャ" Classes="toolbar toolbar-icon" Click="OnCaptureWindowClick" Margin="1" VerticalAlignment="Center">
                <PathIcon x:Name="WindowSelectIcon" Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}"/>
            </Button>
            <Button ToolTip.Tip="領域選択キャプチャ" Classes="toolbar toolbar-icon" Click="OnCaptureAreaClick" Margin="1" VerticalAlignment="Center">
                <PathIcon x:Name="AreaSelectIcon" Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}"/>
            </Button>
            <Border Classes="toolbar-separator"/>
            <Button x:Name="CropButton" Classes="toolbar toolbar-icon" ToolTip.Tip="切り出し（切出しモード開始/終了）" IsEnabled="{Binding CanCopy}" Click="OnCropButtonClick" Margin="1" VerticalAlignment="Center">
                <PathIcon x:Name="CropIcon" Width="{DynamicResource ToolbarIconSize}" Height="{DynamicResource ToolbarIconSize}"/>
            </Button>

        </WrapPanel>

        <!-- メイン画像エリア（背景色は他の UI 版と同じ。 テーマ別の値は AppPalette が単一所有する） -->
        <Grid Grid.Row="1" x:Name="ImageAreaGrid"
              Background="{DynamicResource ImageAreaBackgroundBrush}"
              PointerPressed="OnImageAreaPointerPressed">
            <!-- 画像の 4 辺・4 隅の影（幅・濃さは App.Core の ShadowPlan が単一所有する）は
                 CropViewControl.SurroundRenderer が同じ描画面へ先に描く（重ねると画像の端の混色の
                 下地が背景になり、画像と影の間に白い線として見える）。 -->

            <!-- 高レベル複合コントロール（ズーム・パン・Fit + 領域選択 + ルーペを内包。ScrollViewer 不使用。
                 ズーム率・座標変換・オーバーレイの配線を一本化した CropViewControl）
                 自動切り出し（LineDetection 検出）のホバー強調も `HighlightSourceRect` / `HighlightAppearance` で
                 本コントロールへ委譲する（ホストはコントロールを重ねない）。 -->
<crop:CropViewControl x:Name="CropView"
                           Background="Transparent"/>

        </Grid>

        <!-- ステータスバー（左: 保存済み/未 | 保存ファイル名 / 右: 拡大率（スライダ + % + フライアウト）） -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="4,1" MinHeight="32" VerticalAlignment="Center">
            <!-- 左側（左寄せ）: ポインタ座標（固定幅） | 画像サイズ（固定幅） | 保存済み/未 | 保存ファイル名 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Classes="status" Text="{Binding PointerDisplayText}" Width="70"
                           ToolTip.Tip="マウスポインタ位置（対象座標 = 画像ピクセル）"/>
                <TextBlock Classes="status" Text="{Binding ImageSizeDisplayText}" Width="80"
                           ToolTip.Tip="画像サイズ（対象座標 = 元画像ピクセル）"/>
                <TextBlock Classes="status" Text="{Binding SaveStatusText}"/>
                <TextBlock Classes="status" Text="{Binding SavedFileName}"/>
                <TextBlock Classes="status" Text="{Binding StatusMessage}" Foreground="{StaticResource AnnounceForeground}"/>
            </StackPanel>

            <!-- 右側（右寄せ）: 拡大率 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- ズームアウト（⊖）。フライアウトの選択肢（25〜500%）に沿ってズームアウトする -->
                <Button x:Name="ZoomOutButton" Classes="status" ToolTip.Tip="ズームアウト（25〜500% の選択肢）"
                        Click="OnZoomOutButtonClick"
                        IsEnabled="False"
                        Padding="2,0"
                        MinWidth="22"
                        Height="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center">
                    <PathIcon x:Name="ZoomOutIcon" Width="14" Height="14"/>
                </Button>

                <!-- スライダ（10〜500%。0=自動はフライアウトでのみ選択）。
                     高さ 24px: SliderHorizontalHeight（テンプレート MinHeight）と整合させ、
                     Pre/Post 余白（10px）+ トラック（4px）= 24px に収めてトラックを中央に表示する -->
                <Slider x:Name="ZoomSlider"
                        Width="120"
                        Minimum="10"
                        Maximum="500"
                        VerticalAlignment="Center"
                        Margin="0"
                        ValueChanged="OnZoomSliderValueChanged"
                        ToolTip.Tip="拡大率を調整（10〜500%）" />

                <!-- ズームイン（⊕）。フライアウトの選択肢（25〜500%）に沿ってズームインする -->
                <Button x:Name="ZoomInButton" Classes="status" ToolTip.Tip="ズームイン（25〜500% の選択肢）"
                        Click="OnZoomInButtonClick"
                        IsEnabled="False"
                        Padding="2,0"
                        MinWidth="22"
                        Height="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center">
                    <PathIcon x:Name="ZoomInIcon" Width="14" Height="14"/>
                </Button>

                <!-- Fit 表示（ウィンドウに合わせて画像を表示） -->
                <Button Classes="status" ToolTip.Tip="ウィンドウに合わせて表示（Fit）"
                        Click="OnZoomFitButtonClick"
                        Padding="4,0"
                        MinWidth="30"
                        Height="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock Classes="status" Text="Fit" HorizontalAlignment="Center"/>
                </Button>

                <!-- % 表示（クリックで拡大率選択フライアウトを表示）。500% が入る固定幅・テキスト中央寄せ -->
                <Button x:Name="ZoomPercentButton" Classes="status"
                        Width="56"
                        Padding="0"
                        Height="20"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.Tip="クリックで拡大率を選択">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Header="自動" Tag="0" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="10%" Tag="10" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="15%" Tag="15" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="25%" Tag="25" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="35%" Tag="35" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="50%" Tag="50" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="75%" Tag="75" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="100%" Tag="100" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="150%" Tag="150" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="200%" Tag="200" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="250%" Tag="250" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="350%" Tag="350" Click="OnZoomFlyoutItemClick"/>
                            <MenuItem Header="500%" Tag="500" Click="OnZoomFlyoutItemClick"/>
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock x:Name="ZoomPercentText" Classes="status" Text="{Binding ZoomDisplayText}" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
