<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:EsUtil.SaveEvidence.App.Core.ViewModels;assembly=App.Core"
             xmlns:thumb="clr-namespace:EsUtil.Ui.AvaloniaUI.Thumbnail;assembly=EsUtil.Ui.AvaloniaUI.Thumbnail"
             x:Class="EsUtil.SaveEvidence.App.AvaloniaUI.Views.Pages.FolderViewPage"
             x:DataType="vm:FolderViewViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ツールバー。上部の余白はウィンドウ最上部（タイトルバー領域）とのスペース。右側の余白はウィンドウ右上のシステムボタン（最小化・最大化・閉じる）との重なりを防止 -->
        <!-- 各 ToggleButton は x:Name で個別参照する（Tag ベースの一括走査は行わない） -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="2,6,140,2">
            <Button Classes="toolbar" Content="最新の情報に更新" Click="OnRefreshClick" Margin="1"/>
            <Border Classes="toolbar-separator"/>
            <ToggleButton x:Name="ExtraLargeButton" Classes="toolbar" Content="特大" Click="OnViewModeClick" Tag="0" Margin="1"/>
            <ToggleButton x:Name="LargeButton" Classes="toolbar" Content="大" Click="OnViewModeClick" Tag="1" Margin="1"/>
            <ToggleButton x:Name="MediumButton" Classes="toolbar" Content="中" Click="OnViewModeClick" Tag="2" Margin="1"/>
            <Border Classes="toolbar-separator"/>
            <ToggleButton x:Name="SortAscendingButton" Classes="toolbar" Content="▲ 昇順" Click="OnSortAscendingClick" Tag="asc" Margin="1"/>
            <ToggleButton x:Name="SortDescendingButton" Classes="toolbar" Content="▼ 降順" Click="OnSortDescendingClick" Tag="desc" Margin="1"/>
        </WrapPanel>

        <!-- サムネイル一覧（Undo 一覧と同じ共通コントロール。 枠・影・名前の行は EsUtil.Feature.Thumbnail が単一所有する） -->
        <!-- 一覧の下地は 4 UI 版で同じ色にする（値は AppPalette.ListBackground（App.Core）が単一所有する） -->
        <thumb:ThumbnailControl x:Name="FileListBox" Grid.Row="1"
                                Background="{DynamicResource ListBackgroundBrush}"/>

        <!-- ステータスバー -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="4,2">
            <TextBlock Grid.Column="0" Classes="status" Text="{Binding ItemCountText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="1" Classes="status" Text="{Binding ViewModeText}" Margin="0,0,8,0"/>
            <TextBlock Grid.Column="2" Classes="status" Text="{Binding SortStatusText}" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="3" Classes="status" Text="{Binding FolderPathText}" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</UserControl>
