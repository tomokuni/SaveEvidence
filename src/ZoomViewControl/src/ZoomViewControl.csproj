<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.AvaloniaUI.ZoomView</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- コアの座標値型（PointD / RectD / SizeD / VectorD）を利用するため、PlatformFactory を参照する
         （座標変換の純粋関数（ZoomMath）を UI 非依存にするための依存。汎用コントロール本体は PlatformFactory の
         画像・プラットフォーム機能には依存しない） -->
    <ProjectReference Include="..\..\PlatformFactory\src\PlatformFactory.csproj" />
    <ProjectReference Include="..\..\..\..\Estable\src\Estable\Estable.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="ZoomViewControl.Tests" />
  </ItemGroup>

</Project>
