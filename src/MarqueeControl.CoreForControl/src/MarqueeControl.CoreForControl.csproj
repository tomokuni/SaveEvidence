<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.Marquee.CoreForControl</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574 で検出。公開メンバーの未記載は対象外）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- コア（選択の判断・状態・装飾）への橋渡しを行う層のため、コアとその基盤を参照する。
         装飾は同じアセンブリ（MarqueeControl.Core）の Decoration 名前空間にある。 -->
    <ProjectReference Include="..\..\MarqueeControl.Core\src\MarqueeControl.Core.csproj" />
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ホイール要求のログ定義（LoggerMessage ソース生成）を本層が所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部型（ホイールの回転量換算・ズーム要求のログ定義）は本層の内部手順であり、
         単体テストにのみ公開する（UI 実装・ホストは参照しない）。 -->
    <InternalsVisibleTo Include="MarqueeControl.CoreForControl.Tests" />
  </ItemGroup>

</Project>
