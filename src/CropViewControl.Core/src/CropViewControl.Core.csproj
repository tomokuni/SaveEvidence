<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.CropView</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="CropViewControl.AvaloniaUI" />
    <InternalsVisibleTo Include="CropViewControl.MewUI" />
    <InternalsVisibleTo Include="CropViewControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="CropViewControl.MewUI.Tests" />
    <InternalsVisibleTo Include="CropViewControl.Core.Tests" />
  </ItemGroup>

</Project>
