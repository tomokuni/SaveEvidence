<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Estable.DragRect</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 入力の判断と描画状態変更のログ定義（LoggerMessage ソース生成）をコアが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型は UI 実装とテストからのみ参照する（公開 API を増やさない） -->
    <InternalsVisibleTo Include="DragRectControl.AvaloniaUI" />
    <InternalsVisibleTo Include="DragRectControl.MewUI" />
    <InternalsVisibleTo Include="DragRectControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="DragRectControl.MewUI.Tests" />
    <InternalsVisibleTo Include="DragRectControl.Core.Tests" />
    <!-- MewUI 版の撮影セッションもラベル文言の選定（FadeMaskLabels）を共用する -->
    <InternalsVisibleTo Include="CaptureSessionControl.MewUI" />
    <!-- 複合コントロールのコアも装飾の契約（FadeMaskRenderMode）を参照する -->
    <InternalsVisibleTo Include="FadeMaskDragRectControl.Core" />
  </ItemGroup>
</Project>
