<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Estable.AvaloniaUI.SnipCaptureUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="[12.*,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
    <Page Remove="..\tests\**" />
    <AvaloniaXaml Remove="..\tests\**" />
    <EmbeddedResource Remove="..\tests\**" />
    <!-- sample/ は独立したサンプルアプリケーションのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\sample\**" />
    <None Remove="..\sample\**" />
    <Page Remove="..\sample\**" />
    <AvaloniaXaml Remove="..\sample\**" />
    <EmbeddedResource Remove="..\sample\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テストから internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="SnipCaptureUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FadeMaskDragRectControl\src\FadeMaskDragRectControl.csproj" />
    <ProjectReference Include="..\..\PlatformFactory\src\PlatformFactory.csproj" />
    <ProjectReference Include="..\..\Primitives\src\Primitives.csproj" />
    <ProjectReference Include="..\..\ZoomViewControl\src\ZoomViewControl.csproj" />
  </ItemGroup>

</Project>

