<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.CaptureSession.MewUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- MewUI は API が安定化中（0.x）。破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI のコントロール・描画（Windows 向け全バックエンド + SkiaCanvasView + GPU ブリッジ） -->
    <PackageReference Include="Aprillz.MewUI.Windows" Version="$(MewUIVersion)" />
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <PackageReference Include="Aprillz.MewUI.Skia.Interop.Direct2D" Version="$(MewUIVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則（切り出し矩形・設定・セッション状態・退避手順） -->
    <ProjectReference Include="..\..\CaptureSessionControl.Core\src\CaptureSessionControl.Core.csproj" />
    <!-- 設定 → 色の写像（両 UI で同じ写像を使う） -->
    <ProjectReference Include="..\..\CaptureSessionControl.UIBase\src\CaptureSessionControl.UIBase.csproj" />
    <!-- MewUI 版 Interop（コア型 ⇔ MewUI 型）と DIP 変換 -->
    <ProjectReference Include="..\..\Platform.MewUI\src\Platform.MewUI.csproj" />
    <!-- コアロジックを共有する MewUI 版コントロール（選択オーバーレイ・切り出しビュー） -->
    <ProjectReference Include="..\..\FadeMaskDragRectControl.MewUI\src\FadeMaskDragRectControl.MewUI.csproj" />
    <ProjectReference Include="..\..\CropViewControl.MewUI\src\CropViewControl.MewUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本プロジェクトにテストプロジェクトは無いため InternalsVisibleTo を設けない
         （internal 型は同一アセンブリからのみ使用する。使わない IVT は残さない）。
         検証はコア（CaptureSessionControl.Core.Tests）が共通規則を担保する。 -->
  </ItemGroup>

</Project>
