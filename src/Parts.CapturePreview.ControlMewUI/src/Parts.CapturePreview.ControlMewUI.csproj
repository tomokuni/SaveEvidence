<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.MewUI</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aprillz.MewUI.Windows" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- 撮影・切り出しの共通規則と提示の写像（切り出し矩形・設定・セッション状態・色の写像） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <PackageReference Include="EsUtil.Ui.MewUI.Interop" />
    <!-- コア幾何型と Skia の描画プリミティブ -->
    <PackageReference Include="EsUtil.Platform.Core" />
    <!-- 複合コントロールを構成する内包コントロール -->
    <PackageReference Include="EsUtil.Ui.MewUI.Marquee" />
    <PackageReference Include="EsUtil.Ui.MewUI.Loupe" />
  </ItemGroup>

  <ItemGroup>
    <!-- internal 型（切り出しビューの描画・複合コントロールの内部手順）はテストからのみ参照する（指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Parts.CapturePreview.ControlMewUI.Tests" />
  </ItemGroup>

</Project>
