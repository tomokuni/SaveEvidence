<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.SaveEvidence.App.MewUI</RootNamespace>
    <!-- 実行ファイルの名前は製品名を優先する（配布物の exe 名。 命名規約の例外）。 -->
    <AssemblyName>SaveEvidence.MewUI</AssemblyName>
    <!-- MewUI は API が安定化中（0.x）。 破壊的変更を避けるためバージョンを固定する。 -->
    <MewUIVersion>0.21.1</MewUIVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core + Win32 プラットフォームホスト + Windows 向け全描画バックエンド -->
    <PackageReference Include="Aprillz.MewUI.Windows" Version="$(MewUIVersion)" />
    <!-- SkiaCanvasView（EsBitmap をそのまま描画する） -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="$(MewUIVersion)" />
    <!-- Direct2D ↔ Skia の GPU ブリッジ（未登録でも CPU 経路で動作するが、描画コストが高い） -->
    <PackageReference Include="Aprillz.MewUI.Skia.Interop.Direct2D" Version="$(MewUIVersion)" />
    <!-- 操作ログ（Avalonia 版と同一のファイルへ出力する） -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="[10.*,)" />
    <PackageReference Include="Serilog" Version="[4.*,)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="[10.*,)" />
    <PackageReference Include="Serilog.Sinks.File" Version="[7.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 非依存のコア（設定・ViewModel・画像コンテナ） -->
    <ProjectReference Include="..\..\App.Core\src\App.Core.csproj" />
    <!-- 撮影・切り出しの共通規則（切り出し矩形の計算） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <!-- MewUI 版の撮影セッション（オーバーレイ・切り出しビュー） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.ControlMewUI\src\Parts.CapturePreview.ControlMewUI.csproj" />
    <!-- MewUI 版 Interop（コア型 ⇔ MewUI 型） -->
    <ProjectReference Include="..\..\Platform.MewUI\src\Platform.MewUI.csproj" />
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil.Ui.MewUI\Thumbnail\src\EsUtil.Ui.MewUI.Thumbnail.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部型（サービス・ビュー）をテストから検証できるようにする -->
    <InternalsVisibleTo Include="App.MewUI.Tests" />
  </ItemGroup>


</Project>
