<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EsUtil.SaveEvidence.App.MewUI</RootNamespace>
    <!-- 実行ファイルの名前は製品名を優先する（配布物の exe 名。 命名規約の例外）。 -->
    <AssemblyName>SaveEvidence.MewUI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core + Win32 プラットフォームホスト + Windows 向け全描画バックエンド -->
    <PackageReference Include="Aprillz.MewUI.Windows" />
    <!-- SkiaCanvasView（EsBitmap をそのまま描画する） -->
    <!-- Direct2D ↔ Skia の GPU ブリッジ（未登録でも CPU 経路で動作するが、描画コストが高い） -->
    <!-- 操作ログ（Avalonia 版と同一のファイルへ出力する） -->
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 非依存のコア（設定・ViewModel・画像コンテナ） -->
    <ProjectReference Include="..\..\App.Core\src\App.Core.csproj" />
    <!-- 撮影・切り出しの共通規則（切り出し矩形の計算） -->
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <ProjectReference Include="..\..\Parts.CapturePreview.ControlMewUI\src\Parts.CapturePreview.ControlMewUI.csproj" />
    <PackageReference Include="EsUtil.Ui.MewUI.Interop" />
    <PackageReference Include="EsUtil.Ui.MewUI.Thumbnail" />
    <!-- 設定画面の色選択（色名・16 進・ピッカーを 1 つにまとめたコントロール） -->
    <PackageReference Include="EsUtil.Ui.MewUI.ColorComboBox" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部型（サービス・ビュー）をテストから検証できるようにする -->
    <InternalsVisibleTo Include="App.MewUI.Tests" />
  </ItemGroup>


</Project>
