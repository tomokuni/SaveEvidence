<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LineDetectionSample.ViewModels"
             xmlns:models="clr-namespace:LineDetectionSample.Models"
             x:Class="LineDetectionSample.Views.CreatePage"
             x:DataType="vm:CreatePageViewModel">

    <DockPanel>

        <!-- ───────────── 左: 操作パネル ───────────── -->
        <Border DockPanel.Dock="Left" Width="300" Padding="12"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <TextBlock Text="スクリーンから DragRect で領域を選択し、領域内のウィンドウから正解を選択して保存します。"
                               FontSize="11" TextWrapping="Wrap"/>
                    <Button Content="キャプチャ開始（DragRect）" Click="OnCaptureClicked" HorizontalAlignment="Stretch"
                            ToolTip.Tip="スクリーン上でドラッグして領域を選択します。Enter / ダブルクリックで確定、Esc でキャンセル。"/>
                    <Button Content="保存（PNG + JSON）" Command="{Binding SaveCommand}"
                            HorizontalAlignment="Stretch" IsEnabled="{Binding CanSave}"/>

                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap" Foreground="#444444"/>
                    <TextBlock Text="保存先" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastSavedPath}" FontSize="11" TextWrapping="Wrap" Foreground="#666666"/>

                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="領域内ウィンドウ（正解を選択）" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="Orange" CornerRadius="8" Padding="6,1">
                            <TextBlock Text="{Binding SelectedCount}" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="チェックしたウィンドウが正解として保存されます。" FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding WindowInfos}" MaxHeight="420">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:WindowInfoItem">
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Summary}" FontSize="11" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ───────────── 中央: キャプチャ画像 + 正解オーバーレイ ───────────── -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
            <Grid x:Name="DatasetImageHost" Background="#FF2B2B2B">
                <Image Source="{Binding CapturedImage}" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top"/>

                <!-- 選択された正解ウィンドウのオーバーレイ（オレンジ枠） -->
                <ItemsControl ItemsSource="{Binding WindowInfos}" IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:WindowInfoItem">
                            <Border BorderBrush="Orange"
                                    BorderThickness="3"
                                    Width="{Binding Bounds.Width}"
                                    Height="{Binding Bounds.Height}"
                                    IsVisible="{Binding IsSelected}">
                                <Border.RenderTransform>
                                    <TranslateTransform X="{Binding Bounds.X}" Y="{Binding Bounds.Y}"/>
                                </Border.RenderTransform>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Viewbox>

    </DockPanel>

</UserControl>
