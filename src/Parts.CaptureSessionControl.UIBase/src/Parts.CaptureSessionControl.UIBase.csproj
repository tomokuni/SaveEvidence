<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CaptureSession.UIBase</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- 写像元の設定型（CaptureSettings）と、複合コントロールの設定値・動作モード・状態 -->
    <ProjectReference Include="..\..\Parts.CapturePreviewControl.Core\src\Parts.CapturePreviewControl.Core.csproj" />
    <!-- 内包コントロールの設定型（MarqueeOptions / LoupeOptions） -->
    <ProjectReference Include="..\..\EsUtil.Feature.Marquee.Core\src\EsUtil.Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.Core\src\EsUtil.Feature.Loupe.Core.csproj" />
    <!-- 写像先の色（MarqueePaint / LoupePaint）と付加情報ラベルの体裁（MarqueeHostLabelRenderer）。
         描画の設定は UI 非依存の型のため本層で共有できる
         （コアから描画の設定を参照すると Core → UIBase の逆流になる）。 -->
    <ProjectReference Include="..\..\EsUtil.Feature.Marquee.Presenter\src\EsUtil.Feature.Marquee.Presenter.csproj" />
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.Presenter\src\EsUtil.Feature.Loupe.Presenter.csproj" />
    <!-- コア幾何型 -->
    <ProjectReference Include="..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 写像とラベル配置は両 UI のホストとテストからのみ参照する（公開 API を増やさない。 指定はアセンブリ名） -->
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.AvaloniaUI" />
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.MewUI" />
    <InternalsVisibleTo Include="Parts.CaptureSessionControl.UIBase.Tests" />
  </ItemGroup>


</Project>
