<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI.Sample.ViewModels"
        xmlns:crop="clr-namespace:EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI.Crop;assembly=Parts.CapturePreview.ControlAvaloniaUI"
        x:Class="EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI.Sample.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="CapturePreview.AvaloniaUI 動作確認サンプル"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- ───────────────────────── 上: 操作ガイド ───────────────────────── -->
        <Border DockPanel.Dock="Top" Padding="10" Background="#FAFAFA"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <TextBlock Text="CapturePreview.AvaloniaUI サンプル" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="キャプチャ: 全画面 / ウィンドウ選択 / 範囲選択（ルーペ付き）を実行して結果画像を表示します。"/>
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="切出し（Crop）: 右側のプレビュー画像上でドラッグ選択し、Enter / ダブルクリックで確定します。"/>
                <TextBlock FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                           Text="プレビューのズーム: マウスドラッグでパン、Ctrl+ホイールでズーム、⊖⊕/Fit/スライダで拡大率を変更します。"/>
            </StackPanel>
        </Border>

        <!-- ───────────────────────── 左: 操作パネル ───────────────────────── -->
        <Border DockPanel.Dock="Left" Width="280" Padding="10"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Background="#FAFAFA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="8">

                    <TextBlock Text="キャプチャ" FontSize="13" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="全画面" Click="OnScreenSelectClicked"/>
                        <Button Content="ウィンドウ選択" Click="OnWindowSelectClicked"/>
                    </StackPanel>
                    <Button Content="範囲選択（AreaSelect）" Click="OnAreaSelectClicked"/>

                    <Separator/>

                    <TextBlock Text="プレビューのズーム" FontSize="13" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ZoomOutButton" Content="⊖" MinWidth="36" Click="OnZoomOutClick"
                                IsEnabled="False" ToolTip.Tip="ズームアウト（段階遷移）"/>
                        <Button x:Name="ZoomInButton" Content="⊕" MinWidth="36" Click="OnZoomInClick"
                                IsEnabled="False" ToolTip.Tip="ズームイン（段階遷移）"/>
                        <Button Content="Fit" MinWidth="44" Click="OnZoomFitClick"
                                ToolTip.Tip="Fit 表示（自動）"/>
                        <TextBlock Text="{Binding ZoomDisplayText}" MinWidth="52"
                                   VerticalAlignment="Center" TextAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Text="拡大率（スライダ 10〜500%）" FontSize="11"/>
                    <Slider x:Name="ZoomSlider" Minimum="10" Maximum="500"
                            ToolTip.Tip="拡大率（10〜500%）"/>
                    <CheckBox Content="中央寄せ（CenterAlign）" IsChecked="{Binding CenterAlign, Mode=TwoWay}"
                              ToolTip.Tip="OFF で左上寄せ（Fit 表示中に画像がビューポートより小さい場合に反映）"/>

                    <Separator/>

                    <TextBlock Text="プレビュー画像" FontSize="13" FontWeight="Bold"/>
                    <Button Content="画像を開く..." Click="OnOpenImageClick" HorizontalAlignment="Stretch"
                            ToolTip.Tip="画像ファイル（PNG / JPG / BMP / GIF / WEBP）をプレビューへ表示する"/>
                    <TextBlock Text="{Binding PreviewImageSizeText}" FontSize="12" Foreground="#666666"/>
                    <TextBlock x:Name="PointerPositionText" Text="ポインタ: -" FontSize="12" Foreground="#666666"/>

                    <Separator/>

                    <TextBlock Text="切出し（Crop）" FontSize="13" FontWeight="Bold"/>
                    <Button Content="プレビューで切出し" Click="OnCropClicked"/>

                    <Separator/>

                    <TextBlock Text="ルーペ設定（AreaSelect）" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="拡大倍率（LoupeZoomLevel）" FontSize="11"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LoupeZoomLevel}" FontSize="11"/>
                        <Slider Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding LoupeZoomLevel, Mode=TwoWay}"/>
                    </DockPanel>

                    <Separator/>

                    <TextBlock Text="操作" FontSize="13" FontWeight="Bold"/>
                    <Button Content="キャンセル" Click="OnCancelClicked"/>
                    <Button Content="確定（Crop のみ有効）" Click="OnConfirmClicked"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ───────────────────────── 右: 結果 + Crop プレビュー + ログ ───────────────────────── -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150" MinHeight="60"/>
            </Grid.RowDefinitions>

            <!-- キャプチャ結果 -->
            <Border Grid.Row="0" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Image x:Name="ResultImage" Stretch="Uniform"
                           Source="{Binding CapturedImage}"
                           Margin="8"/>
                    <TextBlock Text="キャプチャ結果はここに表示されます（キャプチャ開始後）" FontSize="11" Foreground="Gray"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 結果テキスト -->
            <TextBlock Grid.Row="1" Text="{Binding ResultText}" FontSize="12" Margin="4,6"
                       TextWrapping="Wrap"/>

            <!-- Crop プレビュー（拡大・パン・Fit 対応の高レベル複合コントロール） -->
            <Border Grid.Row="2" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="切出し（Crop）プレビュー: ドラッグで選択 → Enter / ダブルクリックで確定（マウスホイールで拡大・パン）"
                               FontSize="11" Foreground="Gray" Margin="8,4"/>
                    <crop:CropViewControl x:Name="PreviewCropView"/>
                </DockPanel>
            </Border>

            <Separator Grid.Row="3" Margin="0,6"/>

            <!-- 操作ログ -->
            <Border Grid.Row="4" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="操作ログ" FontSize="11" Foreground="Gray" Margin="8,4"/>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontSize="11"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
