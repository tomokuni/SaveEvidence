<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Platform.MewUI</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.Platform.MewUI</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- MewUI のコア（型・値型）と Skia 描画（SkiaCanvasView・SKCanvas）。プラットフォームホストは含まない -->
    <PackageReference Include="Aprillz.MewUI.Core" Version="0.21.1" />
    <!-- EsBitmap を Skia キャンバスへ描く表示ビュー（SkiaImageView）が SkiaCanvasView を使う -->
    <PackageReference Include="Aprillz.MewUI.Skia" Version="0.21.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- 単体テスト（tests/）からのみ internal 型へアクセスできるようにする -->
    <InternalsVisibleTo Include="App.Platform.MewUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skia への依存を閉じ込めた層（SkiaEsCanvas / EsBitmap の Skia 相互変換） -->
    <ProjectReference Include="..\..\App.Platform.Skia\src\App.Platform.Skia.csproj" />
  </ItemGroup>

</Project>
