<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CaptureSession.UIBase</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.Parts.CaptureSession.UIBase</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- 写像元の設定型（CaptureSettings）と、複合コントロールの設定値・動作モード・状態 -->
    <ProjectReference Include="..\..\App.Parts.CapturePreviewControl.Core\src\App.Parts.CapturePreviewControl.Core.csproj" />
    <!-- 内包コントロールの設定型（MarqueeOptions / LoupeOptions） -->
    <ProjectReference Include="..\..\Feature.Marquee.Core\src\Core\Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\Feature.Loupe.Core\src\Core\Feature.Loupe.Core.csproj" />
    <!-- 写像先の色（MarqueePaint / LoupePaint）と付加情報ラベルの体裁（MarqueeHostLabelRenderer）。
         描画の設定は UI 非依存の型のため本層で共有できる
         （コアから描画の設定を参照すると Core → UIBase の逆流になる）。 -->
    <ProjectReference Include="..\..\Feature.Marquee.Presenter\src\Presenter\Feature.Marquee.Presenter.csproj" />
    <ProjectReference Include="..\..\Feature.Loupe.Presenter\src\Presenter\Feature.Loupe.Presenter.csproj" />
    <!-- コア幾何型 -->
    <ProjectReference Include="..\..\Platform.Core\src\Platform.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 写像とラベル配置は両 UI のホストとテストからのみ参照する（公開 API を増やさない。 指定はアセンブリ名） -->
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CapturePreview.MewUI" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.UIBase.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- tests/ は独立したテストプロジェクトのため、本プロジェクトのコンパイル対象から除外する（src/ の外） -->
    <Compile Remove="..\tests\**" />
    <None Remove="..\tests\**" />
  </ItemGroup>

</Project>
