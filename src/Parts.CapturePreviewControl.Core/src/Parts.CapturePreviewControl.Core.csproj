<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 内包する選択矩形・ルーペのコア（穴あけ装飾・最大サイズ・ヒットテストの規則を再利用する） -->
    <ProjectReference Include="..\..\EsUtil.Feature.Marquee.Core\src\EsUtil.Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.Core\src\EsUtil.Feature.Loupe.Core.csproj" />
    <!-- 提示層の外観（設定 → 色の写像の写像先。 UI 非依存の型のため本層から参照できる） -->
    <ProjectReference Include="..\..\EsUtil.Feature.Marquee.Presenter\src\EsUtil.Feature.Marquee.Presenter.csproj" />
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.Presenter\src\EsUtil.Feature.Loupe.Presenter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定・入力の判断のログ定義（LoggerMessage ソース生成）を本プロジェクトが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部手順（切り出し矩形の解決・状態機械・幾何計算）は UI 実装とテストからのみ参照する -->
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.AvaloniaUI" />
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.MewUI" />
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.Core.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="Parts.CapturePreviewControl.MewUI.Tests" />
  </ItemGroup>

</Project>
