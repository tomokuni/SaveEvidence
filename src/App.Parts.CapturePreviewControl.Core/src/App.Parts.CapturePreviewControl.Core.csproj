<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.Parts.CapturePreview.Core</RootNamespace>
    <AssemblyName>EsUtil.SaveEvidence.Parts.CapturePreview.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ドキュメントコメントを検証する（存在しないメンバーへの cref を CS1574、公開メンバーの未記載を CS1591 で検出）。
         XML は配布物（bin / publish）へ出さない（検証だけに使う）。 -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 内包する選択矩形・ルーペのコア（穴あけ装飾・最大サイズ・ヒットテストの規則を再利用する） -->
    <ProjectReference Include="..\..\EsUtil.Feature.Marquee.Core\src\EsUtil.Feature.Marquee.Core.csproj" />
    <ProjectReference Include="..\..\EsUtil.Feature.Loupe.Core\src\EsUtil.Feature.Loupe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定・入力の判断のログ定義（LoggerMessage ソース生成）を本プロジェクトが所有する -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.*,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内部手順（切り出し矩形の解決・状態機械・幾何計算）は UI 実装とテストからのみ参照する -->
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CapturePreview.AvaloniaUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CapturePreview.MewUI" />
    <InternalsVisibleTo Include="EsUtil.SaveEvidence.Parts.CaptureSession.UIBase" />
    <InternalsVisibleTo Include="App.Parts.CapturePreviewControl.Core.Tests" />
    <InternalsVisibleTo Include="App.Parts.CapturePreviewControl.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="App.Parts.CapturePreviewControl.MewUI.Tests" />
    <InternalsVisibleTo Include="App.Parts.CaptureSessionControl.UIBase.Tests" />
  </ItemGroup>

</Project>
