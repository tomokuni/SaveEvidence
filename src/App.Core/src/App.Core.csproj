<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.App.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CsWin32 が生成する Win32 の宣言（ウィンドウ枠の計測・AUMID の設定）で unsafe を使う -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
    <!-- Win32 の宣言は CsWin32 が生成する（ソース生成だけを目的とするため実行時依存を持たない。
         規則は ../../.github/ビルド設定規約.md §7）。 生成対象は src/NativeMethods.txt。 -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="[0.3.*,)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- アイコンの SVG は 4 つの UI 版で共有する（UI 版ごとに複製すると片方だけ直したときに見た目がずれる）。
         論理名は SvgIconLoader の ResourcePrefix と一致させる -->
    <EmbeddedResource Include="Icons\*.svg">
      <LogicalName>EsUtil.SaveEvidence.App.Core.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Parts.CapturePreview.Core\src\Parts.CapturePreview.Core.csproj" />
    <ProjectReference Include="..\..\..\..\EsUtil\EsUtil\Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 自動切り出しの矩形検出（LineDetection は UI 非依存） -->
    <ProjectReference Include="..\..\Parts.LineDetection\src\Parts.LineDetection.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- internal 型は UI 実装（アプリ）とテストからのみ参照する（公開 API を増やさない）。
         アプリのアセンブリ名は製品名（SaveEvidence.AvaloniaUI / SaveEvidence.MewUI / SaveEvidence.WinUI3 / SaveEvidence.WinForms）のため、
         プロジェクト名ではなくその名前で許可する。 -->
    <InternalsVisibleTo Include="SaveEvidence.AvaloniaUI" />
    <InternalsVisibleTo Include="SaveEvidence.MewUI" />
    <InternalsVisibleTo Include="SaveEvidence.WinUI3" />
    <InternalsVisibleTo Include="SaveEvidence.WinForms" />
    <InternalsVisibleTo Include="App.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="App.Core.Tests" />
    <InternalsVisibleTo Include="App.MewUI.Tests" />
    <InternalsVisibleTo Include="App.WinUI3.Tests" />
    <InternalsVisibleTo Include="App.WinForms.Tests" />
  </ItemGroup>

</Project>
