<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EsUtil.SaveEvidence.App.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);MVVMTK0042</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.*,)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Parts.CapturePreviewControl.Core\src\Parts.CapturePreviewControl.Core.csproj" />
    <ProjectReference Include="..\..\EsUtil.Platform.Core\src\EsUtil.Platform.Core.csproj" />
    <!-- 自動切り出しの矩形検出（LineDetection は UI 非依存） -->
    <ProjectReference Include="..\..\Parts.LineDetection\src\Parts.LineDetection.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- internal 型は UI 実装（アプリ）とテストからのみ参照する（公開 API を増やさない）。
         アプリのアセンブリ名は製品名（SaveEvidence.AvaloniaUI / SaveEvidence.MewUI）のため、プロジェクト名ではなくその名前で許可する。 -->
    <InternalsVisibleTo Include="SaveEvidence.AvaloniaUI" />
    <InternalsVisibleTo Include="SaveEvidence.MewUI" />
    <InternalsVisibleTo Include="App.AvaloniaUI.Tests" />
    <InternalsVisibleTo Include="App.Core.Tests" />
    <InternalsVisibleTo Include="App.MewUI.Tests" />
  </ItemGroup>

</Project>
