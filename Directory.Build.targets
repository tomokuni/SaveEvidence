<Project>

  <!-- ============================================================
       依存関係（ProjectReference）の検査。
       規則の所有者は .github/依存関係.md であり、本ファイルはその実装である。
       規則を変えるときは .github/依存関係.md を先に更新する。

       検査の対象は src/ の本体プロジェクトだけとする（テスト・サンプルは対象プロジェクトと
       検証用の追加参照を持つため、規則の対象外）。
       双方向の参照（循環）は MSBuild が MSB4006 で検出する。
       ============================================================ -->
  <Target Name="ValidateProjectReferences" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' != ''">

    <ItemGroup>
      <_SeRef Include="@(ProjectReference)">
        <Name>%(Filename)</Name>
      </_SeRef>
      <!-- 本リポジトリの外を指す参照（`..\..\..\..\EsUtil\…` のような隣のリポジトリ）。
           別リポジトリの層は**公開パッケージ**として参照する（ソースの一致は保証できないため）。 -->
      <_SeOutsideRef Include="@(ProjectReference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(\.\.[\\/]){3,}'))">
        <Name>%(Filename)</Name>
      </_SeOutsideRef>
    </ItemGroup>

    <PropertyGroup>
      <_SeIsTestOrSample>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '\.(Tests|Sample)$'))</_SeIsTestOrSample>

      <!-- 層の判定（プロジェクト名から導出する。 規則の表は .github/依存関係.md §2・§4） -->
      <_SeIsFeatureCore>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^EsUtil\.Feature\.[A-Za-z]+\.Core$'))</_SeIsFeatureCore>
      <_SeIsFeaturePresenter>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^EsUtil\.Feature\.[A-Za-z]+\.Presenter$'))</_SeIsFeaturePresenter>
      <_SeIsUiLayer>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^(EsUtil\.Feature\.[A-Za-z0-9]+\.Control[A-Za-z0-9]*|Platform\.[A-Za-z0-9]+|Parts\.[A-Za-z0-9]+\.(ControlAvaloniaUI|ControlMewUI|ControlWinUI3|ControlWinForms|AvaloniaUI|MewUI|WinUI3|WinForms)|ColorPickerControl\.[A-Za-z0-9]+)$'))</_SeIsUiLayer>
      <_SeIsUiIndependentCore>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^(Parts\.[A-Za-z]+\.Core|App\.Core)$'))</_SeIsUiIndependentCore>

      <!-- 提示層が参照してよい同一機能のコア名（例: EsUtil.Feature.Loupe.Presenter → EsUtil.Feature.Loupe.Core） -->
      <_SeFeatureCoreName Condition="'$(_SeIsFeaturePresenter)' == 'true'">$([System.Text.RegularExpressions.Regex]::Replace('$(MSBuildProjectName)', '\.Presenter$', '.Core'))</_SeFeatureCoreName>
    </PropertyGroup>

    <!-- UI 層はアプリを参照しない -->
    <ItemGroup Condition="'$(_SeIsTestOrSample)' != 'true' And '$(_SeIsUiLayer)' == 'true'">
      <_SeBad4 Include="@(_SeRef)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Name)', '^App\.'))" />
    </ItemGroup>
    <Error Condition="'@(_SeBad4)' != ''"
           Code="DEP0004"
           Text="依存関係違反: UI 層はアプリ（App.*）を参照できません（違反: @(_SeBad4->'%(Name)', ', ')）。 規則は .github/依存関係.md §4・§5。" />

    <!-- R5: UI 非依存の層は UI 層を参照しない -->
    <ItemGroup Condition="'$(_SeIsTestOrSample)' != 'true' And '$(_SeIsUiIndependentCore)' == 'true'">
      <_SeBad5 Include="@(_SeRef)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Name)', '^(Platform\.(AvaloniaUI|MewUI|WinUI3|WinForms)|Parts\.[A-Za-z0-9]+\.(ControlAvaloniaUI|ControlMewUI|ControlWinUI3|ControlWinForms|AvaloniaUI|MewUI|WinUI3|WinForms)|App\.(AvaloniaUI|MewUI|WinUI3|WinForms)|EsUtil\.Feature\.[A-Za-z0-9]+\.Control[A-Za-z0-9]*|ColorPickerControl\.[A-Za-z0-9]+)$'))" />
    </ItemGroup>
    <Error Condition="'@(_SeBad5)' != ''"
           Code="DEP0005"
           Text="依存関係違反: UI 非依存の層（Parts.*.Core / App.Core）は UI 層を参照できません（違反: @(_SeBad5->'%(Name)', ', ')）。 規則は .github/依存関係.md §4・§5。" />

    <!-- R6: プラットフォーム層は上位（アプリ・Parts・Feature）を参照しない -->
    <ItemGroup Condition="'$(_SeIsTestOrSample)' != 'true' And $([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '^Platform\.[A-Za-z]+$'))">
      <_SeBad6 Include="@(_SeRef)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Name)', '^(App\.|Parts\.|EsUtil\.Feature\.|ColorPickerControl\.)'))" />
    </ItemGroup>
    <Error Condition="'@(_SeBad6)' != ''"
           Code="DEP0006"
           Text="依存関係違反: プラットフォーム層は上位（アプリ・Parts・Feature）を参照できません（違反: @(_SeBad6->'%(Name)', ', ')）。 規則は .github/依存関係.md §4。" />

    <!-- R7: 本リポジトリの外のプロジェクトは ProjectReference で参照しない（公開パッケージを使う） -->
    <Error Condition="'@(_SeOutsideRef)' != ''"
           Code="DEP0007"
           Text="依存関係違反: 本リポジトリの外のプロジェクトを ProjectReference で参照できません（参照: @(_SeOutsideRef->'%(Name)', ', ')）。 別リポジトリの層は PackageReference で参照します。 規則は .github/依存関係.md §1。" />

  </Target>

  <!-- ============================================================
       ビルド設定（実効値）の検査。
       規則の所有者は .github/ビルド設定規約.md であり、本ファイルはその実装である。
       規則を変えるときは .github/ビルド設定規約.md を先に更新する。

       `Directory.Build.props` のテキストは MSBuild から読めないため、ここでは「実効値」を検査する
       （テキストの重複指定は buildScript/verify.ps1 が検査する）。
       ============================================================ -->
  <Target Name="ValidateProjectSettings" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' != ''">

    <PropertyGroup>
      <_SeIsTestOrSample>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '\.(Tests|Sample)$'))</_SeIsTestOrSample>
      <!-- テスト プロジェクトの RootNamespace が `.Tests` で終わるか（`Condition` へ否定を直接書けないため事前計算する） -->
      <_SeIsTestProject>$([System.Text.RegularExpressions.Regex]::IsMatch('$(MSBuildProjectName)', '\.Tests$'))</_SeIsTestProject>
      <_SeTestRootNamespaceOk>$([System.Text.RegularExpressions.Regex]::IsMatch('$(RootNamespace)', '\.Tests$'))</_SeTestRootNamespaceOk>
    </PropertyGroup>

    <!-- BUILD0001: コード スタイルとドキュメントコメントの検証（4 プロパティは Directory.Build.props が単一所有する） -->
    <Error Condition="'$(EnforceCodeStyleInBuild)' != 'true'" Code="BUILD0001"
           Text="ビルド設定違反: EnforceCodeStyleInBuild が true ではありません（Directory.Build.props が所有します）。 規則は .github/ビルド設定規約.md §3。" />
    <Error Condition="'$(GenerateDocumentationFile)' != 'true'" Code="BUILD0001"
           Text="ビルド設定違反: GenerateDocumentationFile が true ではありません（Directory.Build.props が所有します）。 規則は .github/ビルド設定規約.md §3。" />
    <Error Condition="'$(CopyDocumentationFileToOutputDirectory)' != 'false'" Code="BUILD0001"
           Text="ビルド設定違反: CopyDocumentationFileToOutputDirectory が false ではありません（配布物へ XML を出しません）。 規則は .github/ビルド設定規約.md §3。" />
    <Error Condition="'$(PublishDocumentationFiles)' != 'false'" Code="BUILD0001"
           Text="ビルド設定違反: PublishDocumentationFiles が false ではありません（配布物へ XML を出しません）。 規則は .github/ビルド設定規約.md §3。" />

    <!-- BUILD0002: アナライザーの解析モードと警告のエラー化（Directory.Build.props が単一所有する） -->
    <Error Condition="'$(AnalysisLevel)' == ''" Code="BUILD0002"
           Text="ビルド設定違反: AnalysisLevel が未指定です（Directory.Build.props が所有します）。 規則は .github/ビルド設定規約.md §3。" />
    <Error Condition="'$(AnalysisMode)' != 'Recommended'" Code="BUILD0002"
           Text="ビルド設定違反: AnalysisMode が Recommended ではありません（無効にする規則は .editorconfig に severity = none で書きます）。 規則は .github/ビルド設定規約.md §3。" />
    <Error Condition="'$(TreatWarningsAsErrors)' != 'true'" Code="BUILD0002"
           Text="ビルド設定違反: TreatWarningsAsErrors が true ではありません（dotnet build の終了コードで規約準拠を判定します）。 規則は .github/ビルド設定規約.md §3。" />

    <!-- BUILD0003: クラスライブラリのアセンブリ名はプロジェクト名（= フォルダ名）と一致させる -->
    <Error Condition="'$(_SeIsTestOrSample)' != 'true' And '$(OutputType)' != 'WinExe' And '$(AssemblyName)' != '$(MSBuildProjectName)'" Code="BUILD0003"
           Text="命名規約違反: アセンブリ名 '$(AssemblyName)' がプロジェクト名 '$(MSBuildProjectName)' と一致しません（クラスライブラリの AssemblyName は省略します）。 規則は .github/命名規約.md「アセンブリ名」。" />

    <!-- BUILD0004: テスト プロジェクトの RootNamespace は対象の名前空間 + .Tests -->
    <Error Condition="'$(_SeIsTestProject)' == 'true' And '$(_SeTestRootNamespaceOk)' != 'true'" Code="BUILD0004"
           Text="命名規約違反: テスト プロジェクト '$(MSBuildProjectName)' の RootNamespace '$(RootNamespace)' が .Tests で終わっていません。 規則は .github/テスト規約.md §1。" />

  </Target>

  <!-- ============================================================
       Windows App SDK 自己完結の同封物から、使わないコンポーネントを除く。
       規則の所有者は .github/ビルド設定規約.md であり、本ファイルはその実装である。
       規則を変えるときは .github/ビルド設定規約.md を先に更新する。

       背景（実測 2026-10-16）:
         同封物は `Microsoft.WindowsAppSDK.Runtime` が持つ
         `tools\Msix\win10-<arch>\Microsoft.WindowsAppRuntime.*.Msix` を
         `obj\<構成>\<TFM>\<RID>\MsixContent\` へ展開したものから作られる
         （Microsoft.WindowsAppSDK.SelfContained.targets の
         `ExtractMicrosoftWindowsAppSDKMsixFiles` /
         `AddMicrosoftWindowsAppSDKPayloadFilesFromMsix`）。
         MSIX は全コンポーネント（AI / ML / Widgets 等）を単一の塊として含むため、
         `WindowsAppSdkComponentPackages` からコンポーネントを外しても減らない
         （同封物は展開済みの MSIX から作られ、元のパッケージ一覧を使わない。 実測）。
         `MicrosoftWindowsAppSDKFilesExcluded` も同封物の作成「前」にしか効かないため使えない。
         展開後・コピー前に `None` から外すのが唯一効く点である。

       対象は ML（ONNX Runtime と DirectML）・Windows AI・Widgets のネイティブ実体
       （合計 43.7 MB。 本アプリはこれらの API を呼ばない = ソース参照 0 件）。
       Widgets は Windows App SDK 自身も自己完結の登録対象から外している
       （同 targets の `CreateWinRTRegistration` のコメントを参照）。
       除去後の起動と設定の往復は buildScript/verifyPublish.ps1 が検証する。
       ============================================================ -->
  <Target Name="ExcludeUnusedWindowsAppSdkPayload"
          AfterTargets="AddMicrosoftWindowsAppSDKPayloadFilesFromMsix"
          Condition="'$(WindowsAppSDKSelfContained)' == 'true' And '$(MicrosoftWindowsAppSDKMsixContent)' != ''">
    <ItemGroup>
      <!-- ML（機械学習の実行時） -->
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime.dll" />
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\onnxruntime_providers_shared.dll" />
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\DirectML.dll" />
      <!-- Windows AI（AI API の実装） -->
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.AI.*.dll" />
      <!-- Widgets（ウィジェット） -->
      <None Remove="$(MicrosoftWindowsAppSDKMsixContent)\Microsoft.Windows.Widgets.dll" />
    </ItemGroup>
  </Target>

</Project>
